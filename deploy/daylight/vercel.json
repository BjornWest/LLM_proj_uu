{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["arn1"],
  "functions": {"api/index.mjs": {"maxDuration": 120, "includeFiles": "private-assets/**"}},
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}]
}
