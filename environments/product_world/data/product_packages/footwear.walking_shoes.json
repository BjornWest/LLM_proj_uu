  "steps": [
    {
      "id": "positioning",
      "target": "profile.positioning",
      "sample": "weighted_choice",
      "weights_from": "brand.positioning_weights",
      "stream": "product/walking_shoes/positioning"
    },
    {
      "id": "emphasis",
      "target": "profile.emphasis",
      "sample": "weighted_choice",
      "weights_from": "brand.emphasis_weights",
      "stream": "product/walking_shoes/emphasis"
    },
    {
      "id": "execution",
      "target": "profile.execution",
      "sample": "uniform",
      "min": 0.1,
      "max": 0.9,
      "stream": "product/walking_shoes/execution"
    },
    {
      "id": "construction",
      "target": "internal.construction",
      "sample": "weighted_choice",
      "weights": {
        "light": 2,
        "balanced": 4,
        "cushioned": 3,
        "structured": 3
      },
      "values": {
        "light": {
          "cushioning": "light",
          "footbed": "flat foam footbed",
          "sole_structure": "flexible",
          "base_mass_g": 240
        },
        "balanced": {
          "cushioning": "moderate",
          "footbed": "gently contoured foam footbed",
          "sole_structure": "moderately flexible",
          "base_mass_g": 290
        },
        "cushioned": {
          "cushioning": "substantial",
          "footbed": "thick foam footbed",
          "sole_structure": "moderately flexible",
          "base_mass_g": 310
        },
        "structured": {
          "cushioning": "moderate",
          "footbed": "contoured foam footbed",
          "sole_structure": "firm",
          "base_mass_g": 360
        }
      },
      "adjustments": [
        {
          "when": "profile.emphasis == 'cushioning'",
          "multiply": {
            "light": 0.4,
            "balanced": 1,
            "cushioned": 3,
            "structured": 0.8
          }
        },
        {
          "when": "profile.emphasis == 'lightness'",
          "multiply": {
            "light": 3,
            "balanced": 1.2,
            "cushioned": 0.6,
            "structured": 0.4
          }
        },
        {
          "when": "profile.emphasis == 'support'",
          "multiply": {
            "light": 0.4,
            "balanced": 1,
            "cushioned": 0.8,
            "structured": 3
          }
        }
      ],
      "stream": "product/walking_shoes/construction"
    },
    {
      "id": "cushioning",
      "target": "product.facts.cushioning",
      "derive": "internal.construction.cushioning"
    },
    {
      "id": "footbed",
      "target": "product.facts.footbed",
      "derive": "internal.construction.footbed"
    },
    {
      "id": "sole_structure",
      "target": "product.facts.sole_structure",
      "derive": "internal.construction.sole_structure"
    },
    {
      "id": "material",
      "target": "product.facts.component_materials.upper",
      "sample": "weighted_choice",
      "weights": {
        "mesh and synthetic panels": 4,
        "woven synthetic fabric": 3,
        "leather": 3
      },
      "adjustments": [
        {
          "when": "profile.emphasis == 'lightness'",
          "multiply": {
            "mesh and synthetic panels": 1.8,
            "woven synthetic fabric": 1.5,
            "leather": 0.5
          }
        },
        {
          "when": "profile.positioning == 'budget'",
          "multiply": {
            "mesh and synthetic panels": 1,
            "woven synthetic fabric": 1.6,
            "leather": 0.6
          }
        },
        {
          "when": "profile.positioning == 'mainstream'",
          "multiply": {
            "mesh and synthetic panels": 1,
            "woven synthetic fabric": 1,
            "leather": 1
          }
        },
        {
          "when": "profile.positioning == 'premium'",
          "multiply": {
            "mesh and synthetic panels": 1.2,
            "woven synthetic fabric": 0.9,
            "leather": 1.6
          }
        }
      ],
      "stream": "product/walking_shoes/material"
    },
    {
      "id": "fastening",
      "target": "product.facts.fastening",
      "sample": "weighted_choice",
      "weights": {
        "laces": 7,
        "hook-and-loop straps": 2,
        "slip-on opening": 1
      },
      "adjustments": [],
      "stream": "product/walking_shoes/fastening"
    },
    {
      "id": "sole_tread",
      "target": "product.facts.sole_tread",
      "sample": "weighted_choice",
      "weights": {
        "shallow": 4,
        "moderate": 4,
        "pronounced": 2
      },
      "adjustments": [
        {
          "when": "profile.emphasis == 'cushioning'",
          "multiply": {
            "shallow": 1.4,
            "moderate": 1,
            "pronounced": 0.6
          }
        },
        {
          "when": "profile.emphasis == 'lightness'",
          "multiply": {
            "shallow": 1.5,
            "moderate": 1,
            "pronounced": 0.5
          }
        },
        {
          "when": "profile.emphasis == 'support'",
          "multiply": {
            "shallow": 0.6,
            "moderate": 1.5,
            "pronounced": 1.3
          }
        }
      ],
      "stream": "product/walking_shoes/tread"
    },
    {
      "id": "mass_noise",
      "target": "internal.mass_noise_g",
      "sample": "uniform_int",
      "min": -15,
      "max": 15,
      "stream": "product/walking_shoes/mass"
    },
    {
      "id": "mass",
      "target": "product.facts.reference_mass_g",
      "derive": "internal.construction.base_mass_g + internal.mass_noise_g"
    },
    {
      "id": "width_set",
      "target": "product.widths",
      "sample": "weighted_choice",
      "weights": {
        "regular_only": 50,
        "regular_wide": 20,
        "regular_narrow": 10,
        "regular_narrow_wide": 20
      },
      "values": {
        "regular_only": [
          "standard"
        ],
        "regular_wide": [
          "standard",
          "wide"
        ],
        "regular_narrow": [
          "standard",
          "narrow"
        ],
        "regular_narrow_wide": [
          "standard",
          "narrow",
          "wide"
        ]
      },
      "stream": "product/walking_shoes/width_set"
    },
    {
      "id": "colours",
      "target": "product.colours",
      "sample": "weighted_subset",
      "weights": {
        "black": 5,
        "navy": 3,
        "brown": 2,
        "olive": 2,
        "stone": 3,
        "white": 3,
        "grey": 3,
        "burgundy": 1,
        "blue": 2,
        "pink": 1
      },
      "count_weights": {
        "1": 25,
        "2": 40,
        "3": 25,
        "4": 10
      },
      "streams": {
        "count": "product/walking_shoes/colour_count",
        "item": "product/walking_shoes/colour_{index}"
      }
    },
    {
      "id": "size_range",
      "target": "product.sizes_eu",
      "sample": "weighted_choice",
      "weights": {
        "38_42": 1,
        "39_44": 1,
        "38_44": 1
      },
      "values": {
        "38_42": [
          38,
          39,
          40,
          41,
          42
        ],
        "39_44": [
          39,
          40,
          41,
          42,
          43,
          44
        ],
        "38_44": [
          38,
          39,
          40,
          41,
          42,
          43,
          44
        ]
      },
      "stream": "product/walking_shoes/size_range"
    },
    {
      "id": "width_groups",
      "for_each": {
        "binding": "group.width",
        "from": "product.widths"
      },
      "steps": [
        {
          "id": "width_colour_mode",
          "target": "group.colour_mode",
          "sample": "weighted_choice",
          "weights": {
            "all": 1,
            "subset": 0
          },
          "cases": [
            {
              "when": "group.width != 'standard'",
              "weights": {
                "all": 60,
                "subset": 40
              }
            }
          ],
          "stream": "product/walking_shoes/colour_coverage/{width}"
        },
        {
          "id": "width_colour_count",
          "target": "group.colour_count",
          "sample": "uniform_int",
          "min": "len(product.colours)",
          "max": "len(product.colours)",
          "cases": [
            {
              "when": "group.colour_mode == 'subset' and len(product.colours) > 1",
              "min": 1,
              "max": "len(product.colours) - 1"
            }
          ],
          "stream": "product/walking_shoes/colour_subset_count/{width}"
        },
        {
          "id": "width_colours",
          "target": "group.colours",
          "sample": "weighted_subset",
          "weights": {
            "black": 5,
            "navy": 3,
            "brown": 2,
            "olive": 2,
            "stone": 3,
            "white": 3,
            "grey": 3,
            "burgundy": 1,
            "blue": 2,
            "pink": 1
          },
          "eligible_from": "product.colours",
          "count_from": "group.colour_count",
          "streams": {
            "item": "product/walking_shoes/colour_subset/{width}/{index}"
          }
        },
        {
          "id": "colour_groups",
          "for_each": {
            "binding": "group.colour",
            "from": "group.colours"
          },
          "steps": [
            {
              "id": "size_mode",
              "target": "group.size_mode",
              "sample": "weighted_choice",
              "weights": {
                "full": 75,
                "subrange": 20,
                "alternating": 5
              },
              "stream": "product/walking_shoes/sizes/{colour}/{width}/mode"
            },
            {
              "id": "size_coverage",
              "target": "group.sizes",
              "sample": "uniform_choice",
              "values_from": "coverage_groups(product.sizes_eu, group.size_mode)",
              "stream": "product/walking_shoes/sizes/{colour}/{width}/coverage"
            },
            {
              "id": "sku_sizes",
              "for_each": {
                "binding": "group.size",
                "from": "group.sizes"
              },
              "steps": [
                {
                  "id": "skus",
                  "target": "product.skus",
                  "emit": {
                    "sku_id": "product.product_id + '-' + group.colour + '-' + group.width + '-' + str(group.size)",
                    "product_id": "product.product_id",
                    "colour": "group.colour",
                    "width": "group.width",
                    "size_eu": "group.size"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "price",
      "target": "product.reference_price_sek",
      "sample": "uniform",
      "min": 450,
      "max": 950,
      "round_to": 10,
      "cases": [
        {
          "when": "profile.positioning == 'mainstream'",
          "min": 850,
          "max": 1600
        },
        {
          "when": "profile.positioning == 'premium'",
          "min": 1400,
          "max": 2400
        }
      ],
      "stream": "product/walking_shoes/price"
    }
  ],
