  "steps": [
    {
      "id": "laminate_bundle",
      "target": "internal.laminate",
      "sample": "weighted_choice",
      "weights": {
        "two": 2,
        "two_half": 4,
        "three": 3
      },
      "values": {
        "two": {
          "layers": "2-layer",
          "face": "polyester",
          "membrane": "PU membrane",
          "inner": "separate mesh lining",
          "mass_g": 350
        },
        "two_half": {
          "layers": "2.5-layer",
          "face": "nylon",
          "membrane": "PU membrane",
          "inner": "protective inner print",
          "mass_g": 300
        },
        "three": {
          "layers": "3-layer",
          "face": "nylon",
          "membrane": "PU membrane",
          "inner": "tricot backing",
          "mass_g": 420
        }
      }
    },
    {
      "id": "layers",
      "target": "product.facts.laminate_layers",
      "derive": "internal.laminate.layers"
    },
    {
      "id": "face",
      "target": "product.facts.face_fabric",
      "derive": "internal.laminate.face"
    },
    {
      "id": "membrane",
      "target": "product.facts.membrane",
      "derive": "internal.laminate.membrane"
    },
    {
      "id": "inner",
      "target": "product.facts.inner_structure",
      "derive": "internal.laminate.inner"
    },
    {
      "id": "dwr",
      "target": "product.facts.dwr",
      "sample": "weighted_choice",
      "weights": {
        "yes": 4,
        "no": 1
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "cut",
      "target": "product.facts.cut",
      "sample": "weighted_choice",
      "weights": {
        "regular": 3,
        "relaxed": 1
      }
    },
    {
      "id": "hood",
      "target": "product.facts.hood_style",
      "sample": "weighted_choice",
      "weights": {
        "absent": 1,
        "attached adjustable": 6,
        "detachable adjustable": 2
      }
    },
    {
      "id": "hood_present",
      "target": "product.facts.hood_present",
      "derive": "product.facts.hood_style != 'absent'"
    },
    {
      "id": "hood_adjustable",
      "target": "product.facts.hood_adjustable",
      "derive": "product.facts.hood_present"
    },
    {
      "id": "hood_detachable",
      "target": "product.facts.hood_detachable",
      "derive": "product.facts.hood_style == 'detachable adjustable'"
    },
    {
      "id": "vents",
      "target": "product.facts.underarm_zip_vents",
      "sample": "weighted_choice",
      "weights": {
        "yes": 3,
        "no": 2
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "head_publication",
      "target": "product.facts.head_published",
      "sample": "weighted_choice",
      "weights": {
        "yes": 2,
        "no": 1
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "head_value",
      "target": "product.facts.declared_hydrostatic_head_mm",
      "sample": "weighted_choice",
      "weights": {
        "10000": 1,
        "20000": 1
      },
      "when": "product.facts.head_published",
      "values": {
        "10000": 10000,
        "20000": 20000
      }
    },
    {
      "id": "mvtr_publication",
      "target": "product.facts.mvtr_published",
      "sample": "weighted_choice",
      "weights": {
        "yes": 1,
        "no": 1
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "mvtr_value",
      "target": "product.facts.declared_mvtr_g_m2_24h",
      "sample": "weighted_choice",
      "weights": {
        "10000": 1,
        "20000": 1
      },
      "when": "product.facts.mvtr_published",
      "values": {
        "10000": 10000,
        "20000": 20000
      }
    },
    {
      "id": "mass_noise",
      "target": "internal.mass_noise_g",
      "sample": "uniform_int",
      "min": -20,
      "max": 20
    },
    {
      "id": "mass",
      "target": "product.facts.reference_mass_g",
      "derive": "internal.laminate.mass_g + internal.mass_noise_g + (25 if product.facts.hood_present else 0) + (15 if product.facts.underarm_zip_vents else 0)"
    }
  ],
  "language": [
    {
      "id": "description.laminate",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.laminate_layers",
          "product.facts.face_fabric",
          "product.facts.membrane",
          "product.facts.inner_structure",
          "product.facts.seam_treatment",
          "product.facts.insulating_fill"
        ]
      },
      "slots": {
        "layers": "product.facts.laminate_layers",
        "face": "product.facts.face_fabric",
        "membrane": "product.facts.membrane",
        "inner": "product.facts.inner_structure"
      },
      "formulations": [
        "Rain shell: {layers} laminate, {face} face, {membrane} and {inner}; all seams taped; no dedicated insulating fill declared.",
        "A {layers} laminate uses {face}, {membrane}, and {inner}. All seams taped, without declared dedicated insulating fill."
      ]
    },
    {
      "id": "description.controls",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.front_closure",
          "product.facts.cut",
          "product.facts.hood_style",
          "product.facts.hood_present",
          "product.facts.hood_adjustable",
          "product.facts.hood_detachable",
          "product.facts.underarm_zip_vents",
          "product.facts.dwr"
        ]
      },
      "slots": {
        "cut": "product.facts.cut",
        "hood": "product.facts.hood_style",
        "vents": "'present' if product.facts.underarm_zip_vents else 'absent'",
        "dwr": "'present' if product.facts.dwr else 'absent'"
      },
      "formulations": [
        "Full front zip; {cut} cut; hood: {hood}; underarm zip vents {vents}; DWR {dwr}.",
        "A {cut}-cut full-zip shell with hood {hood}, underarm zip vents {vents}, and DWR {dwr}."
      ]
    },
    {
      "id": "description.head_known",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.head_published",
          "product.facts.declared_hydrostatic_head_mm",
          "product.facts.test_method",
          "product.facts.test_conditioning"
        ]
      },
      "slots": {
        "head": "product.facts.declared_hydrostatic_head_mm"
      },
      "formulations": [
        "Declared hydrostatic head: {head} mm; test method/conditioning unspecified.",
        "Manufacturer-declared hydrostatic head {head} mm, with no specified test method or conditioning."
      ],
      "when": "product.facts.head_published"
    },
    {
      "id": "description.head_unknown",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.head_published"
        ]
      },
      "slots": {},
      "formulations": [
        "Hydrostatic-head result not published.",
        "No hydrostatic-head value is published."
      ],
      "when": "not product.facts.head_published"
    },
    {
      "id": "description.mvtr_known",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.mvtr_published",
          "product.facts.declared_mvtr_g_m2_24h",
          "product.facts.test_method",
          "product.facts.test_conditioning"
        ]
      },
      "slots": {
        "mvtr": "product.facts.declared_mvtr_g_m2_24h"
      },
      "formulations": [
        "Declared MVTR: {mvtr} g/m²/24h; test method/conditioning unspecified.",
        "Manufacturer-declared MVTR {mvtr} g/m²/24h, with no specified test method or conditioning."
      ],
      "when": "product.facts.mvtr_published"
    },
    {
      "id": "description.mvtr_unknown",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.mvtr_published"
        ]
      },
      "slots": {},
      "formulations": [
        "MVTR result not published.",
        "No MVTR value is published."
      ],
      "when": "not product.facts.mvtr_published"
    },
    {
      "id": "description.mass",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.reference_mass_g",
          "product.facts.mass_basis"
        ]
      },
      "slots": {
        "mass": "product.facts.reference_mass_g"
      },
      "formulations": [
        "One nominal sizeM reference garment weighs {mass} g.",
        "Reference mass: {mass} g for one garment in nominal sizeM."
      ]
    }
  ],
  "rules": [
    {
      "id": "brand_scope",
      "require": "'jackets.rain_shells' in brand.eligible_concepts"
    }
  ],
  "bindings": [
    {
      "id": "hood",
      "role": "filter",
      "predicate": "product.facts.hood_present == request.hood_required",
      "support": "proposal_not_registered"
    },
    {
      "id": "vents",
      "role": "filter",
      "predicate": "product.facts.underarm_zip_vents == request.vents_required",
      "support": "proposal_not_registered"
    },
    {
      "id": "head",
      "role": "task_requirement",
      "predicate": "product.facts.declared_hydrostatic_head_mm >= request.min_head_mm",
      "support": "proposal_not_registered"
    }
  ],
  "programs": {
    "review": {
      "fields": {
        "profile.positioning": {
          "type": "enum",
          "values": [
            "budget",
            "mainstream",
            "premium"
          ],
          "input": true
        },
        "profile.execution": {
          "type": "number",
          "input": true,
          "min": 0,
          "max": 1
        },
        "product.product_id": {
          "type": "string",
          "input": true
        },
        "product.skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "colour": {
                "type": "string"
              },
              "size_label": {
                "type": "string"
              }
            }
          },
          "input": true,
          "min_items": 1
        },
        "review.subject": {
          "type": "object",
          "properties": {
            "sku_id": {
              "type": "string"
            },
            "product_id": {
              "type": "string"
            },
            "colour": {
              "type": "string"
            },
            "size_label": {
              "type": "string"
            }
          }
        },
        "sku.sku_id": {
          "type": "string"
        },
        "sku.product_id": {
          "type": "string"
        },
        "review.rating": {
          "type": "integer",
          "min": 1,
          "max": 5
        },
        "review.eligible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review.topics": {
          "type": "set",
          "items": {
            "type": "enum",
            "values": [
              "value",
              "front_zip_operation",
              "rain_walk_dryness",
              "layering_room",
              "hood_adjustment",
              "vent_operation"
            ]
          }
        },
        "product.reference_price_sek": {
          "type": "number",
          "unit": "SEK",
          "input": true,
          "min": 400,
          "max": 4000
        },
        "review.purchase_price_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.price_min_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 400
        },
        "review.price_max_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 4000
        },
        "review.value_price_position": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.value_favourability": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.positive_value": {
          "type": "boolean"
        },
        "review.positive_front_zip_operation": {
          "type": "boolean"
        },
        "review.positive_rain_walk_dryness": {
          "type": "boolean"
        },
        "review.positive_layering_room": {
          "type": "boolean"
        },
        "review.positive_hood_adjustment": {
          "type": "boolean"
        },
        "review.positive_vent_operation": {
          "type": "boolean"
        },
        "product.facts.hood_adjustable": {
          "type": "boolean",
          "input": true
        },
        "product.facts.underarm_zip_vents": {
          "type": "boolean",
          "input": true
        }
      },
      "steps": [
        {
          "id": "tested_sku",
          "target": "review.subject",
          "sample": "uniform_choice",
          "values_from": "product.skus"
        },
        {
          "id": "tested_id",
          "target": "sku.sku_id",
          "derive": "review.subject.sku_id"
        },
        {
          "id": "tested_product",
          "target": "sku.product_id",
          "derive": "review.subject.product_id"
        },
        {
          "id": "rating",
          "target": "review.rating",
          "sample": "rating",
          "execution": "profile.execution",
          "concentration": 1.5
        },
        {
          "id": "topic_applicability",
          "target": "review.eligible",
          "sample": "weighted_choice",
          "weights": {
            "plain": 1,
            "hood": 0,
            "vents": 0,
            "both": 0
          },
          "cases": [
            {
              "when": "product.facts.hood_adjustable and product.facts.underarm_zip_vents",
              "weights": {
                "plain": 0,
                "hood": 0,
                "vents": 0,
                "both": 1
              }
            },
            {
              "when": "product.facts.hood_adjustable and not product.facts.underarm_zip_vents",
              "weights": {
                "plain": 0,
                "hood": 1,
                "vents": 0,
                "both": 0
              }
            },
            {
              "when": "not product.facts.hood_adjustable and product.facts.underarm_zip_vents",
              "weights": {
                "plain": 0,
                "hood": 0,
                "vents": 1,
                "both": 0
              }
            }
          ],
          "values": {
            "plain": [
              "value",
              "front_zip_operation",
              "rain_walk_dryness",
              "layering_room"
            ],
            "hood": [
              "value",
              "front_zip_operation",
              "rain_walk_dryness",
              "layering_room",
              "hood_adjustment"
            ],
            "vents": [
              "value",
              "front_zip_operation",
              "rain_walk_dryness",
              "layering_room",
              "vent_operation"
            ],
            "both": [
              "value",
              "front_zip_operation",
              "rain_walk_dryness",
              "layering_room",
              "hood_adjustment",
              "vent_operation"
            ]
          }
        },
        {
          "id": "topics",
          "target": "review.topics",
          "sample": "review_topics",
          "execution": "profile.execution",
          "positioning_from": "profile.positioning",
          "eligible_from": "review.eligible",
          "length_weights": {
            "0": 24,
            "1": 4,
            "2": 3,
            "3": 1
          }
        },
        {
          "id": "synthetic_purchase_price",
          "target": "review.purchase_price_sek",
          "derive": "product.reference_price_sek"
        },
        {
          "id": "relative_purchase_price",
          "target": "review.value_price_position",
          "derive": "(review.purchase_price_sek - review.price_min_sek) / (review.price_max_sek - review.price_min_sek)"
        },
        {
          "id": "value_favourability",
          "target": "review.value_favourability",
          "sample": "normal",
          "mean": "(review.rating - 1) / 4 - 0.2 * (review.value_price_position - 0.5)",
          "sd": 0.22,
          "min": 0,
          "max": 1,
          "bounds_mode": "clip",
          "round_to": 1e-06
        },
        {
          "id": "sentiment_value",
          "target": "review.positive_value",
          "derive": "review.value_favourability >= 0.5"
        },
        {
          "id": "sentiment_front_zip_operation",
          "target": "review.positive_front_zip_operation",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
            {
              "when": "review.rating >= 4",
              "weights": {
                "positive": 4,
                "negative": 1
              }
            },
            {
              "when": "review.rating <= 2",
              "weights": {
                "positive": 1,
                "negative": 4
              }
            }
          ],
          "values": {
            "positive": true,
            "negative": false
          }
        },
        {
          "id": "sentiment_rain_walk_dryness",
          "target": "review.positive_rain_walk_dryness",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
            {
              "when": "review.rating >= 4",
              "weights": {
                "positive": 4,
                "negative": 1
              }
            },
            {
              "when": "review.rating <= 2",
              "weights": {
                "positive": 1,
                "negative": 4
              }
            }
          ],
          "values": {
            "positive": true,
            "negative": false
          }
        },
        {
          "id": "sentiment_layering_room",
          "target": "review.positive_layering_room",
          "sample": "weighted_choice",
