{
  "schema_version": "product-package-v1",
  "concept_id": "authoring.phones_base",
  "random_namespace": "product-width-phones-base-v1",
  "status": "shared_authoring_module_not_counted_as_concept",
  "fields": {
    "brand.brand_id": {
      "type": "string",
      "input": true
    },
    "brand.positioning_weights": {
      "type": "object",
      "input": true
    },
    "brand.eligible_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "input": true
    },
    "product.product_id": {
      "type": "string",
      "input": true
    },
    "product.name": {
      "type": "string",
      "optional": true
    },
    "profile.positioning": {
      "type": "enum",
      "values": [
        "budget",
        "mainstream",
        "premium"
      ]
    },
    "profile.execution": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "product.reference_price_sek": {
      "type": "number",
      "unit": "SEK",
      "min": 1500,
      "max": 18000
    },
    "product.skus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "colour": {
            "type": "string"
          },
          "storage_gb": {
            "type": "integer",
            "unit": "GB",
            "min": 128,
            "max": 1000
          },
          "storage_label": {
            "type": "string"
          },
          "ram_gb": {
            "type": "integer",
            "unit": "GB",
            "min": -1,
            "max": 12,
            "unknown_values": [
              -1
            ]
          },
          "storage_price_factor": {
            "type": "number",
            "min": 1,
            "max": 1.25
          },
          "reference_price_sek": {
            "type": "number",
            "unit": "SEK",
            "min": 1500,
            "max": 22500
          }
        }
      },
      "min_items": 1
    },
    "sku.colour": {
      "type": "string",
      "retail_presentation": {
        "allowed": [
          "selector",
          "separate_page"
        ]
      }
    },
    "sku.storage_gb": {
      "type": "integer",
      "unit": "GB",
      "retail_presentation": {
        "allowed": [
          "selector",
          "separate_page"
        ]
      }
    },
    "group.colour": {
      "type": "string"
    },
    "group.storage_key": {
      "type": "string"
    },
    "group.storage_gb": {
      "type": "integer",
      "unit": "GB"
    },
    "group.storage_label": {
      "type": "string"
    },
    "group.storage_price_factor": {
      "type": "number"
    },
    "group.reference_price_sek": {
      "type": "number",
      "unit": "SEK"
    }
  },
  "steps": [
    {
      "id": "positioning",
      "target": "profile.positioning",
      "sample": "weighted_choice",
      "weights_from": "brand.positioning_weights"
    },
    {
      "id": "execution",
      "target": "profile.execution",
      "sample": "uniform",
      "min": 0.05,
      "max": 0.95
    },
    {
      "id": "price",
      "target": "product.reference_price_sek",
      "sample": "uniform",
      "min": 1500,
      "max": 4500,
      "round_to": 10,
      "cases": [
        {
          "when": "profile.positioning == 'mainstream'",
          "min": 3500,
          "max": 9000
        },
        {
          "when": "profile.positioning == 'premium'",
          "min": 7000,
          "max": 18000
        }
      ]
    }
  ],
  "language": [],
  "rules": [],
  "bindings": [],
  "metadata": {
    "purpose": "Neutral model/profile identity and phone canonical storage/colour schema. Manufacture/hardware belong to child; no headphone fields or downstream stock."
  }
}
