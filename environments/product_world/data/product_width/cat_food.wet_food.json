{
  "schema_version": "product-package-v1",
  "concept_id": "cat_food.wet_food",
  "random_namespace": "product-width-cat_food.wet_food-v1",
  "extends": "_wet_pet_food_base.json",
  "status": "domain_accepted_not_production_integrated",
  "fields": {
    "product.facts.species": {
      "type": "string",
      "constant": "cat",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.presentation": {
      "type": "string",
      "constant": "wet food in single-use non-reclosable pouches",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.life_stage": {
      "type": "enum",
      "values": [
        "adult",
        "senior"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.declared_target": {
      "type": "string",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.texture": {
      "type": "enum",
      "values": [
        "loaf",
        "jelly",
        "broth"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.named_ingredient": {
      "type": "enum",
      "values": [
        "chicken",
        "salmon"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.named_ingredient_pct": {
      "type": "number",
      "unit": "%",
      "min": -1,
      "max": 12,
      "unknown_values": [
        -1
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.other_named_ingredients": {
      "type": "string",
      "constant": "other animal derivatives, rice, minerals and liquid",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.composition_scope": {
      "type": "string",
      "constant": "partial unordered whole-food disclosure; other animal ingredients not excluded",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.dietary_role": {
      "type": "enum",
      "values": [
        "complete",
        "complementary",
        "not specified"
      ],
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "internal.analysis": {
      "type": "object",
      "properties": {
        "moisture": {
          "type": "number",
          "unit": "%",
          "min": -1,
          "max": 100
        },
        "protein": {
          "type": "number",
          "unit": "%",
          "min": -1,
          "max": 100
        },
        "fat": {
          "type": "number",
          "unit": "%",
          "min": -1,
          "max": 100
        },
        "fibre": {
          "type": "number",
          "unit": "%",
          "min": -1,
          "max": 100
        },
        "ash": {
          "type": "number",
          "unit": "%",
          "min": -1,
          "max": 100
        }
      }
    },
    "product.facts.moisture_pct": {
      "type": "number",
      "unit": "%",
      "min": -1,
      "max": 100,
      "unknown_values": [
        -1
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.protein_pct": {
      "type": "number",
      "unit": "%",
      "min": -1,
      "max": 100,
      "unknown_values": [
        -1
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.fat_pct": {
      "type": "number",
      "unit": "%",
      "min": -1,
      "max": 100,
      "unknown_values": [
        -1
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.fibre_pct": {
      "type": "number",
      "unit": "%",
      "min": -1,
      "max": 100,
      "unknown_values": [
        -1
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.ash_pct": {
      "type": "number",
      "unit": "%",
      "min": -1,
      "max": 100,
      "unknown_values": [
        -1
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.analytical_basis": {
      "type": "string",
      "constant": "label percent of food as sold",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.calorific_energy": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.analysis_protocol": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.taurine_additive": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.total_taurine_assay": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.individual_dietary_suitability": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.opening_method": {
      "type": "enum",
      "values": [
        "tear-notch",
        "precut-tab"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.dispensing_action": {
      "type": "enum",
      "values": [
        "scraping",
        "squeezing"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "request.life_stage": {
      "type": "string",
      "optional": true
    },
    "request.texture": {
      "type": "string",
      "optional": true
    }
  },
  "steps": [
    {
      "id": "life_stage",
      "target": "product.facts.life_stage",
      "sample": "weighted_choice",
      "weights": {
        "adult": 5,
        "senior": 2
      }
    },
    {
      "id": "target_label",
      "target": "product.facts.declared_target",
      "derive": "'ages 1+ years' if product.facts.life_stage == 'adult' else 'ages 7+ years'"
    },
    {
      "id": "texture",
      "target": "product.facts.texture",
      "sample": "weighted_choice",
      "weights": {
        "loaf": 1,
        "jelly": 3,
        "broth": 2
      }
    },
    {
      "id": "ingredient",
      "target": "product.facts.named_ingredient",
      "sample": "weighted_choice",
      "weights": {
        "chicken": 3,
        "salmon": 1
      }
    },
    {
      "id": "ingredient_pct",
      "target": "product.facts.named_ingredient_pct",
      "sample": "weighted_choice",
      "weights": {
        "4": 2,
        "12": 1,
        "unknown": 1
      },
      "values": {
        "4": 4,
        "12": 12,
        "unknown": -1
      }
    },
    {
      "id": "role",
      "target": "product.facts.dietary_role",
      "sample": "weighted_choice",
      "weights": {
        "complete": 5,
        "complementary": 2,
        "not specified": 1
      }
    },
    {
      "id": "analysis",
      "target": "internal.analysis",
      "sample": "weighted_choice",
      "weights": {
        "unknown": 1,
        "loaf": 2,
        "jelly": 0,
        "broth": 0
      },
      "cases": [
        {
          "when": "product.facts.texture == 'jelly'",
          "weights": {
            "unknown": 1,
            "loaf": 0,
            "jelly": 2,
            "broth": 0
          }
        },
        {
          "when": "product.facts.texture == 'broth'",
          "weights": {
            "unknown": 1,
            "loaf": 0,
            "jelly": 0,
            "broth": 2
          }
        }
      ],
      "values": {
        "unknown": {
          "moisture": -1,
          "protein": -1,
          "fat": -1,
          "fibre": -1,
          "ash": -1
        },
        "loaf": {
          "moisture": 78,
          "protein": 10,
          "fat": 5,
          "fibre": 0.5,
          "ash": 2
        },
        "jelly": {
          "moisture": 80,
          "protein": 12,
          "fat": 3,
          "fibre": 0.6,
          "ash": 2.5
        },
        "broth": {
          "moisture": 82,
          "protein": 12,
          "fat": 1,
          "fibre": 0.2,
          "ash": 1.4
        }
      }
    },
    {
      "id": "analytical_moisture",
      "target": "product.facts.moisture_pct",
      "derive": "internal.analysis.moisture"
    },
    {
      "id": "analytical_protein",
      "target": "product.facts.protein_pct",
      "derive": "internal.analysis.protein"
    },
    {
      "id": "analytical_fat",
      "target": "product.facts.fat_pct",
      "derive": "internal.analysis.fat"
    },
    {
      "id": "analytical_fibre",
      "target": "product.facts.fibre_pct",
      "derive": "internal.analysis.fibre"
    },
    {
      "id": "analytical_ash",
      "target": "product.facts.ash_pct",
      "derive": "internal.analysis.ash"
    },
    {
      "id": "opening",
      "target": "product.facts.opening_method",
      "sample": "weighted_choice",
      "weights": {
        "tear-notch": 1,
        "precut-tab": 1
      }
    },
    {
      "id": "dispensing",
      "target": "product.facts.dispensing_action",
      "derive": "'scraping' if product.facts.texture == 'loaf' else 'squeezing'"
    }
  ],
  "language": [
    {
      "id": "description.target",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.species",
          "product.facts.presentation",
          "product.facts.life_stage",
          "product.facts.declared_target",
          "product.facts.texture"
        ]
      },
      "slots": {
        "stage": "product.facts.life_stage",
        "target": "product.facts.declared_target",
        "texture": "product.facts.texture"
      },
      "formulations": [
        "Wet cat food, {texture} texture, in single-use non-reclosable pouches. Declared {stage} target: {target}.",
        "Cat wet-food pouches, {texture}; single-use, not reclosable. Label target {stage}, {target}."
      ]
    },
    {
      "id": "description.formula",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.named_ingredient",
          "product.facts.other_named_ingredients",
          "product.facts.composition_scope"
        ]
      },
      "slots": {
        "ingredient": "product.facts.named_ingredient",
        "other": "product.facts.other_named_ingredients"
      },
      "formulations": [
        "Partial unordered whole-food composition names {ingredient} and {other}. Other animal ingredients are not excluded; no complete formula partition.",
        "Named {ingredient}, plus {other}, in a partial unordered disclosure; not an exclusive animal-protein or exhaustive composition list."
      ]
    },
    {
      "id": "description.ingredient_pct",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.named_ingredient",
          "product.facts.named_ingredient_pct"
        ]
      },
      "slots": {
        "name": "product.facts.named_ingredient",
        "pct": "product.facts.named_ingredient_pct"
      },
      "formulations": [
        "Declared {name} share {pct:g}% of whole food, not a chunk-only share or analytical protein.",
        "{name} {pct:g}% on the whole-food ingredient basis, separate from chunk percentages and protein analysis."
      ],
      "when": "known(product.facts.named_ingredient_pct)"
    },
    {
      "id": "description.ingredient_unknown",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.named_ingredient_pct"
        ]
      },
      "slots": {},
      "formulations": [
        "Named-ingredient share not specified.",
        "No specified named-ingredient percentage."
      ],
      "when": "not known(product.facts.named_ingredient_pct)"
    },
    {
      "id": "description.analysis",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.moisture_pct",
          "product.facts.protein_pct",
          "product.facts.fat_pct",
          "product.facts.fibre_pct",
          "product.facts.ash_pct",
          "product.facts.analytical_basis",
          "product.facts.analysis_protocol"
        ]
      },
      "slots": {
        "moisture": "product.facts.moisture_pct",
        "protein": "product.facts.protein_pct",
        "fat": "product.facts.fat_pct",
        "fibre": "product.facts.fibre_pct",
        "ash": "product.facts.ash_pct"
      },
      "formulations": [
        "Analytical label, food-as-sold percentages: moisture {moisture:g}, protein {protein:g}, fat {fat:g}, crude fibre {fibre:g}, crude ash {ash:g}. Method unspecified.",
        "Food-as-sold label: moisture {moisture:g}%, protein {protein:g}%, fat {fat:g}%, crude fibre {fibre:g}%, crude ash {ash:g}%; no specified analysis protocol."
      ],
      "when": "known(product.facts.moisture_pct) and known(product.facts.protein_pct) and known(product.facts.fat_pct) and known(product.facts.fibre_pct) and known(product.facts.ash_pct)"
    },
    {
      "id": "description.analysis_unknown",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.moisture_pct",
          "product.facts.protein_pct",
          "product.facts.fat_pct",
          "product.facts.fibre_pct",
          "product.facts.ash_pct"
        ]
      },
      "slots": {},
      "formulations": [
        "Moisture/protein/fat/crude-fibre/crude-ash analytical quantities unspecified.",
        "No specified numeric moisture, protein, fat, crude-fibre or crude-ash analysis."
      ],
      "when": "not known(product.facts.protein_pct)"
    },
    {
      "id": "description.role",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.dietary_role",
          "product.facts.individual_dietary_suitability"
        ]
      },
      "slots": {
        "role": "product.facts.dietary_role"
      },
      "formulations": [
        "Dietary-role label: {role}. Label status is not independent nutrient-adequacy validation or individual dietary advice.",
        "Declared {role} food; individual suitability and independent nutrient adequacy are not established."
      ],
      "when": "known(product.facts.dietary_role)"
    },
    {
      "id": "description.role_unknown",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.dietary_role"
        ]
      },
      "slots": {},
      "formulations": [
        "Dietary role unspecified; this does not imply complete or complementary.",
        "No specified complete/complementary dietary-role label."
      ],
      "when": "not known(product.facts.dietary_role)"
    },
    {
      "id": "description.complementary_use",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.dietary_role"
        ]
      },
      "slots": {},
      "formulations": [
        "Complementary food is used alongside the usual complete diet, not as its replacement.",
        "Serve complementary food alongside the usual complete diet; it does not replace complete food."
      ],
      "when": "known(product.facts.dietary_role) and product.facts.dietary_role == 'complementary'"
    },
    {
      "id": "description.opening",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.opening_method",
          "product.facts.dispensing_action"
        ]
      },
      "slots": {
        "opening": "product.facts.opening_method",
        "release": "product.facts.dispensing_action"
      },
      "formulations": [
        "Single-use pouch opens by {opening}; food release by {release}. No reclosability or storage guarantee.",
        "Pouch opening {opening}; dispensing action {release}. Not resealable; freshness/storage performance unspecified."
      ]
    },
    {
      "id": "description.unknowns",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.calorific_energy",
          "product.facts.taurine_additive",
          "product.facts.total_taurine_assay",
          "product.facts.analysis_protocol"
        ]
      },
      "slots": {},
      "formulations": [
        "Calories, taurine additive quantity, total taurine assay and analysis method unspecified.",
        "No calorific-energy, taurine additive/total-assay or analytical-method declaration."
      ]
    },
    {
      "id": "description.price",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.reference_price_basis"
        ]
      },
      "slots": {
        "price": "product.reference_price_sek"
      },
      "formulations": [
        "Synthetic one-kilogram anchor {price} SEK; exact unit/count/total masses and reference prices belong to each pack SKU, not seller quotes.",
        "One-kilogram formula reference {price} SEK. Canonical same-formula packs retain inner mass, unit count, total mass and pack price separately from retail offers."
      ]
    }
  ],
  "rules": [
    {
      "id": "brand_scope",
      "require": "'cat_food.wet_food' in brand.eligible_concepts"
    },
    {
      "id": "partial_analysis_mass",
      "when": "known(product.facts.moisture_pct) and known(product.facts.protein_pct) and known(product.facts.fat_pct) and known(product.facts.fibre_pct) and known(product.facts.ash_pct)",
      "require": "product.facts.moisture_pct + product.facts.protein_pct + product.facts.fat_pct + product.facts.fibre_pct + product.facts.ash_pct <= 100"
    }
  ],
  "bindings": [
    {
      "id": "life_stage",
      "role": "filter",
      "predicate": "product.facts.life_stage == request.life_stage",
      "support": "proposal_not_registered"
    },
    {
      "id": "texture",
      "role": "filter",
      "predicate": "product.facts.texture == request.texture",
      "support": "proposal_not_registered"
    },
    {
      "id": "complete",
      "role": "filter",
      "predicate": "known(product.facts.dietary_role) and product.facts.dietary_role == 'complete'",
      "support": "proposal_not_registered"
    }
  ],
  "programs": {
    "review": {
      "fields": {
        "profile.positioning": {
          "type": "enum",
          "values": [
            "budget",
            "mainstream",
            "premium"
          ],
          "input": true
        },
        "profile.execution": {
          "type": "number",
          "input": true,
          "min": 0,
          "max": 1
        },
        "product.product_id": {
          "type": "string",
          "input": true
        },
        "product.skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "unit_net_mass_g": {
                "type": "integer",
                "unit": "g",
                "min": 70,
                "max": 85
              },
              "unit_count": {
                "type": "integer",
                "min": 1,
                "max": 12
              },
              "total_net_mass_g": {
                "type": "integer",
                "unit": "g",
                "min": 70,
                "max": 1020
              },
              "price_multiplier": {
                "type": "number",
                "min": 0.1,
                "max": 1.2
              },
              "reference_price_sek": {
                "type": "number",
                "unit": "SEK",
                "min": 7,
                "max": 480
              }
            }
          },
          "input": true,
          "min_items": 1
        },
        "review.subject": {
          "type": "object",
          "properties": {
            "sku_id": {
              "type": "string"
            },
            "product_id": {
              "type": "string"
            },
            "unit_net_mass_g": {
              "type": "integer",
              "unit": "g",
              "min": 70,
              "max": 85
            },
            "unit_count": {
              "type": "integer",
              "min": 1,
              "max": 12
            },
            "total_net_mass_g": {
              "type": "integer",
              "unit": "g",
              "min": 70,
              "max": 1020
            },
            "price_multiplier": {
              "type": "number",
              "min": 0.1,
              "max": 1.2
            },
            "reference_price_sek": {
              "type": "number",
              "unit": "SEK",
              "min": 7,
              "max": 480
            }
          }
        },
        "sku.sku_id": {
          "type": "string"
        },
        "sku.product_id": {
          "type": "string"
        },
        "review.rating": {
          "type": "integer",
          "min": 1,
          "max": 5
        },
        "review.eligible": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "constant": [
            "value",
            "meal_acceptance",
            "pouch_release",
            "smell_preference",
            "pouch_opening"
          ]
        },
        "review.topics": {
          "type": "set",
          "items": {
            "type": "enum",
            "values": [
              "value",
              "meal_acceptance",
              "pouch_release",
              "smell_preference",
              "pouch_opening"
            ]
          }
        },
        "product.reference_price_sek": {
          "type": "number",
          "unit": "SEK",
          "input": true,
          "min": 70,
          "max": 400
        },
        "review.purchase_price_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.price_min_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.price_max_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.value_price_position": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.value_favourability": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.positive_value": {
          "type": "boolean"
        },
        "review.positive_meal_acceptance": {
