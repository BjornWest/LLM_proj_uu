      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.pilling_grade": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.thermal_rating": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.waterproof_rating": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
