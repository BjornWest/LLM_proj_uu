{
  "schema_version": "product-package-v1",
  "concept_id": "authoring.chargers_base",
  "random_namespace": "product-width-chargers-base-v1",
  "status": "shared_authoring_module_not_counted_as_concept",
  "fields": {
    "brand.brand_id": {
      "type": "string",
      "input": true
    },
    "brand.positioning_weights": {
      "type": "object",
      "input": true
    },
    "brand.eligible_concepts": {
      "type": "array",
      "items": {
