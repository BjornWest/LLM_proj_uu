          "cable_length_label": {
            "type": "string"
          },
          "cable_capability_status": {
            "type": "enum",
            "values": [
              "unknown",
              "not applicable"
            ]
          },
          "bundle_price_factor": {
            "type": "number",
            "min": 1,
            "max": 1.25
          },
          "reference_price_sek": {
            "type": "number",
            "unit": "SEK",
            "min": 150,
            "max": 1375
          }
        }
      },
      "min_items": 1
    },
    "product.colours": {
      "type": "set",
      "items": {
        "type": "string"
      },
      "min_items": 1
    },
    "product.plug_types": {
      "type": "set",
      "items": {
        "type": "string"
      },
      "min_items": 1
    },
    "product.bundles": {
      "type": "set",
      "items": {
        "type": "string"
      },
      "min_items": 1
    },
    "product.facts.shipping_class": {
      "type": "string",
      "constant": "regular",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "sku.plug_type": {
      "type": "string",
      "retail_presentation": {
        "allowed": [
          "selector",
          "separate_page"
        ]
      }
    },
    "group.plug_type": {
      "type": "string"
    },
    "sku.colour": {
      "type": "string",
      "retail_presentation": {
        "allowed": [
          "selector",
          "separate_page"
        ]
      }
    },
    "group.colour": {
      "type": "string"
    },
    "sku.bundle": {
      "type": "string",
      "retail_presentation": {
        "allowed": [
          "selector",
          "separate_page"
        ]
      }
    },
    "group.bundle": {
      "type": "string"
    }
