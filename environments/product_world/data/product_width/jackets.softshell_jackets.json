        ]
      }
    },
    "internal.mass_noise_g": {
      "type": "integer",
      "unit": "g"
    },
    "product.facts.reference_mass_g": {
      "type": "integer",
      "unit": "g",
      "min": 230,
      "max": 535,
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "request.membrane_required": {
      "type": "boolean",
      "optional": true
    },
    "request.adjustable_hood_required": {
      "type": "boolean",
      "optional": true
    },
    "request.wind_declaration": {
      "type": "string",
      "optional": true
    }
  },
  "steps": [
    {
      "id": "body_bundle",
      "target": "internal.body",
      "sample": "weighted_choice",
      "weights": {
        "woven": 4,
        "membrane": 3
      },
      "values": {
        "woven": {
          "face": "stretch woven nylon",
          "membrane": "none",
          "backing": "no separate lining or backing",
          "stretch": "stretch woven body",
          "mass_g": 250
        },
        "membrane": {
          "face": "polyester",
          "membrane": "polyethylene membrane",
          "backing": "open 3D polyester backing",
          "stretch": "separate stretch panels",
          "mass_g": 480
        }
      }
    },
    {
      "id": "face",
      "target": "product.facts.face_fabric",
      "derive": "internal.body.face"
    },
    {
      "id": "membrane",
      "target": "product.facts.membrane_material",
      "derive": "internal.body.membrane"
    },
    {
      "id": "backing",
      "target": "product.facts.backing",
      "derive": "internal.body.backing"
    },
    {
      "id": "stretch",
      "target": "product.facts.stretch_construction",
      "derive": "internal.body.stretch"
    },
    {
      "id": "membrane_present",
      "target": "product.facts.membrane_present",
      "derive": "internal.body.membrane != 'none'"
    },
    {
      "id": "stretch_panels",
      "target": "product.facts.separate_stretch_panels",
      "derive": "internal.body.stretch == 'separate stretch panels'"
    },
    {
      "id": "wind_declaration",
      "target": "product.facts.wind_declaration",
      "sample": "weighted_choice",
      "weights": {
        "wind resistant": 6,
        "windproof": 1
      },
      "cases": [
        {
          "when": "product.facts.membrane_present",
          "weights": {
            "wind resistant": 1,
            "windproof": 6
          }
        }
      ]
    },
    {
      "id": "dwr",
      "target": "product.facts.dwr",
      "sample": "weighted_choice",
      "weights": {
        "yes": 4,
        "no": 1
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "cut",
      "target": "product.facts.cut",
      "sample": "weighted_choice",
      "weights": {
        "slim": 2,
        "regular": 5,
        "relaxed": 1
      }
    },
    {
      "id": "hood",
      "target": "product.facts.hood_style",
      "sample": "weighted_choice",
      "weights": {
        "absent": 1,
        "fixed": 2,
        "adjustable": 4
      }
    },
    {
      "id": "hood_present",
      "target": "product.facts.hood_present",
      "derive": "product.facts.hood_style != 'absent'"
    },
    {
      "id": "hood_adjustable",
      "target": "product.facts.hood_adjustable",
      "derive": "product.facts.hood_style == 'adjustable'"
    },
    {
      "id": "vents",
      "target": "product.facts.underarm_zip_vents",
      "sample": "weighted_choice",
      "weights": {
        "yes": 1,
        "no": 4
      },
      "cases": [
        {
          "when": "product.facts.membrane_present",
          "weights": {
            "yes": 3,
            "no": 1
          }
        }
      ],
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "ret_publication",
      "target": "product.facts.ret_published",
      "sample": "weighted_choice",
      "weights": {
        "yes": 1,
        "no": 2
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "ret_bound",
      "target": "product.facts.declared_ret_upper_bound",
      "sample": "weighted_choice",
      "weights": {
        "20": 1,
        "30": 1
      },
      "when": "product.facts.ret_published",
      "values": {
        "20": 20,
        "30": 30
      }
    },
    {
      "id": "mass_noise",
      "target": "internal.mass_noise_g",
      "sample": "uniform_int",
      "min": -20,
      "max": 20
    },
    {
      "id": "mass",
      "target": "product.facts.reference_mass_g",
      "derive": "internal.body.mass_g + internal.mass_noise_g + (20 if product.facts.hood_present else 0) + (15 if product.facts.underarm_zip_vents else 0)"
    }
  ],
  "language": [
    {
      "id": "description.body",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.face_fabric",
          "product.facts.membrane_material",
          "product.facts.backing",
          "product.facts.stretch_construction",
          "product.facts.membrane_present",
          "product.facts.separate_stretch_panels",
          "product.facts.stretch_percentage",
          "product.facts.insulating_fill"
        ]
      },
      "slots": {
        "face": "product.facts.face_fabric",
        "membrane": "product.facts.membrane_material",
        "backing": "product.facts.backing",
        "stretch": "product.facts.stretch_construction"
      },
      "formulations": [
        "Softshell body: {face}; membrane: {membrane}; backing/lining: {backing}; stretch construction: {stretch}. Stretch percentage unspecified; no dedicated insulating fill declared.",
        "A {face} softshell with membrane {membrane}, {backing} and {stretch}; no specified stretch percentage or declared dedicated insulating fill."
      ]
    },
    {
      "id": "description.controls",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.front_closure",
          "product.facts.cut",
          "product.facts.hood_style",
          "product.facts.hood_present",
          "product.facts.hood_adjustable",
          "product.facts.underarm_zip_vents",
          "product.facts.dwr"
        ]
      },
      "slots": {
        "cut": "product.facts.cut",
        "hood": "product.facts.hood_style",
        "vents": "'present' if product.facts.underarm_zip_vents else 'absent'",
        "dwr": "'present' if product.facts.dwr else 'absent'"
      },
      "formulations": [
        "Full front zip, {cut} cut, hood {hood}, underarm zip vents {vents}, DWR {dwr}.",
        "A {cut}-cut full-zip jacket; hood: {hood}; underarm zip vents {vents}; DWR {dwr}."
      ]
    },
    {
      "id": "description.wind",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.wind_declaration",
          "product.facts.seam_treatment",
          "product.facts.waterproof_rating",
          "product.facts.air_permeability"
        ]
      },
      "slots": {
        "wind": "product.facts.wind_declaration"
      },
      "formulations": [
        "Manufacturer wind declaration: {wind}; seam treatment, numeric waterproof rating and air permeability unspecified.",
        "Declared {wind}; no specified seam treatment, quantitative waterproof result or air-permeability measurement."
      ]
    },
    {
      "id": "description.ret_known",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.ret_published",
          "product.facts.declared_ret_comparison",
          "product.facts.declared_ret_upper_bound",
          "product.facts.test_method",
          "product.facts.test_conditioning"
        ]
      },
      "slots": {
        "relation": "product.facts.declared_ret_comparison",
        "bound": "product.facts.declared_ret_upper_bound"
      },
      "formulations": [
        "Declared RET {relation}{bound} m²·Pa/W; test method and conditioning unspecified.",
        "Manufacturer declaration: RET {relation}{bound} m²·Pa/W, not an exact result; test method/conditioning unspecified."
      ],
      "when": "product.facts.ret_published"
    },
    {
      "id": "description.ret_unknown",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.ret_published"
        ]
      },
      "slots": {},
      "formulations": [
        "No RET result is published.",
        "RET declaration not published."
      ],
      "when": "not product.facts.ret_published"
    },
    {
      "id": "description.mass",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.reference_mass_g",
          "product.facts.mass_basis"
        ]
      },
      "slots": {
        "mass": "product.facts.reference_mass_g"
      },
      "formulations": [
        "One nominal sizeM reference garment weighs {mass} g.",
        "Reference mass: {mass} g for one garment in nominal sizeM."
      ]
    }
  ],
  "rules": [
    {
      "id": "brand_scope",
      "require": "'jackets.softshell_jackets' in brand.eligible_concepts"
    }
  ],
  "bindings": [
    {
      "id": "membrane",
      "role": "filter",
      "predicate": "product.facts.membrane_present == request.membrane_required",
      "support": "proposal_not_registered"
    },
    {
      "id": "adjustable_hood",
      "role": "filter",
      "predicate": "product.facts.hood_adjustable == request.adjustable_hood_required",
      "support": "proposal_not_registered"
    },
    {
      "id": "wind",
      "role": "filter",
      "predicate": "product.facts.wind_declaration == request.wind_declaration",
      "support": "proposal_not_registered"
    }
  ],
  "programs": {
    "review": {
      "fields": {
        "profile.positioning": {
          "type": "enum",
          "values": [
            "budget",
            "mainstream",
            "premium"
          ],
          "input": true
        },
        "profile.execution": {
          "type": "number",
          "input": true,
          "min": 0,
          "max": 1
        },
        "product.product_id": {
          "type": "string",
          "input": true
        },
        "product.skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "colour": {
                "type": "string"
              },
              "size_label": {
                "type": "string"
              }
            }
          },
          "input": true,
          "min_items": 1
        },
        "review.subject": {
          "type": "object",
          "properties": {
            "sku_id": {
              "type": "string"
            },
            "product_id": {
              "type": "string"
            },
            "colour": {
              "type": "string"
            },
            "size_label": {
              "type": "string"
            }
          }
        },
        "sku.sku_id": {
          "type": "string"
        },
        "sku.product_id": {
          "type": "string"
        },
        "review.rating": {
          "type": "integer",
          "min": 1,
          "max": 5
        },
        "review.eligible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review.topics": {
          "type": "set",
          "items": {
            "type": "enum",
            "values": [
              "value",
              "wind_walk_comfort",
              "arm_movement",
              "front_zip_operation",
              "hood_adjustment",
              "vent_operation"
            ]
          }
        },
        "product.reference_price_sek": {
          "type": "number",
          "unit": "SEK",
          "input": true,
          "min": 500,
          "max": 3800
        },
        "review.purchase_price_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.price_min_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 500
        },
        "review.price_max_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 3800
        },
        "review.value_price_position": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.value_favourability": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.positive_value": {
          "type": "boolean"
        },
        "review.positive_wind_walk_comfort": {
          "type": "boolean"
        },
        "review.positive_arm_movement": {
          "type": "boolean"
        },
        "review.positive_front_zip_operation": {
          "type": "boolean"
        },
        "review.positive_hood_adjustment": {
          "type": "boolean"
        },
        "review.positive_vent_operation": {
          "type": "boolean"
        },
        "product.facts.hood_adjustable": {
          "type": "boolean",
          "input": true
        },
        "product.facts.underarm_zip_vents": {
          "type": "boolean",
          "input": true
        }
      },
      "steps": [
        {
          "id": "tested_sku",
          "target": "review.subject",
          "sample": "uniform_choice",
          "values_from": "product.skus"
        },
        {
          "id": "tested_id",
          "target": "sku.sku_id",
          "derive": "review.subject.sku_id"
        },
        {
          "id": "tested_product",
          "target": "sku.product_id",
          "derive": "review.subject.product_id"
        },
        {
          "id": "rating",
          "target": "review.rating",
          "sample": "rating",
          "execution": "profile.execution",
          "concentration": 1.5
        },
        {
          "id": "topic_applicability",
          "target": "review.eligible",
          "sample": "weighted_choice",
          "weights": {
            "plain": 1,
            "hood": 0,
            "vents": 0,
            "both": 0
          },
          "cases": [
            {
              "when": "product.facts.hood_adjustable and product.facts.underarm_zip_vents",
              "weights": {
                "plain": 0,
                "hood": 0,
                "vents": 0,
                "both": 1
              }
            },
            {
              "when": "product.facts.hood_adjustable and not product.facts.underarm_zip_vents",
              "weights": {
                "plain": 0,
                "hood": 1,
                "vents": 0,
                "both": 0
              }
            },
            {
              "when": "not product.facts.hood_adjustable and product.facts.underarm_zip_vents",
              "weights": {
                "plain": 0,
                "hood": 0,
                "vents": 1,
                "both": 0
              }
            }
          ],
          "values": {
            "plain": [
              "value",
              "wind_walk_comfort",
              "arm_movement",
              "front_zip_operation"
            ],
            "hood": [
              "value",
              "wind_walk_comfort",
              "arm_movement",
              "front_zip_operation",
              "hood_adjustment"
            ],
            "vents": [
              "value",
              "wind_walk_comfort",
              "arm_movement",
              "front_zip_operation",
              "vent_operation"
            ],
            "both": [
              "value",
              "wind_walk_comfort",
              "arm_movement",
              "front_zip_operation",
              "hood_adjustment",
              "vent_operation"
            ]
          }
        },
        {
          "id": "topics",
          "target": "review.topics",
          "sample": "review_topics",
          "execution": "profile.execution",
          "positioning_from": "profile.positioning",
          "eligible_from": "review.eligible",
          "length_weights": {
            "0": 24,
            "1": 4,
            "2": 3,
            "3": 1
          }
        },
        {
          "id": "synthetic_purchase_price",
          "target": "review.purchase_price_sek",
          "derive": "product.reference_price_sek"
        },
        {
          "id": "relative_purchase_price",
          "target": "review.value_price_position",
          "derive": "(review.purchase_price_sek - review.price_min_sek) / (review.price_max_sek - review.price_min_sek)"
        },
        {
          "id": "value_favourability",
          "target": "review.value_favourability",
          "sample": "normal",
          "mean": "(review.rating - 1) / 4 - 0.2 * (review.value_price_position - 0.5)",
          "sd": 0.22,
          "min": 0,
          "max": 1,
          "bounds_mode": "clip",
          "round_to": 1e-06
        },
        {
          "id": "sentiment_value",
          "target": "review.positive_value",
          "derive": "review.value_favourability >= 0.5"
        },
        {
          "id": "sentiment_wind_walk_comfort",
          "target": "review.positive_wind_walk_comfort",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
            {
              "when": "review.rating >= 4",
              "weights": {
                "positive": 4,
                "negative": 1
              }
            },
            {
              "when": "review.rating <= 2",
              "weights": {
                "positive": 1,
                "negative": 4
              }
            }
          ],
          "values": {
            "positive": true,
            "negative": false
          }
        },
        {
          "id": "sentiment_arm_movement",
          "target": "review.positive_arm_movement",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
