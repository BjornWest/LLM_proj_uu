        ]
      }
    },
    "product.facts.declared_ret_upper_bound": {
      "type": "number",
      "unit": "m2 Pa/W",
      "min": 20,
      "max": 30,
      "optional": true,
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.test_method": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
