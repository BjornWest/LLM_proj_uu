      "target": "product.facts.energy_kcal_per100g",
      "derive": "internal.format.kcal_per100g"
    },
    {
      "id": "format_anchor",
      "target": "product.reference_price_sek",
      "derive": "internal.unadjusted_reference_price_sek * internal.format.price_factor"
