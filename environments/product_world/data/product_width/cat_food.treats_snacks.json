          "ingredient_scope": "complete ingredient composition: chicken breast only",
          "other_ingredients": "none in declared composition",
          "protein": 84.7,
          "fat": 4.1,
          "fibre": 0.2,
          "ash": 5.9,
          "moisture": 5.1,
          "kcal_per100g": 331,
          "price_factor": 2
        }
      }
