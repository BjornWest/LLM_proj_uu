    {
      "id": "unknown_loose_piece_count",
      "target": "product.facts.loose_piece_count",
      "derive": "'not specified'",
      "when": "product.facts.format != 'puree'"
    },
    {
      "id": "unknown_mass_per_piece",
      "target": "product.facts.mass_per_piece",
      "derive": "'not specified'",
      "when": "product.facts.format != 'puree'"
    },
    {
      "id": "unknown_calories_per_piece",
      "target": "product.facts.calories_per_piece",
      "derive": "'not specified'",
      "when": "product.facts.format != 'puree'"
    },
    {
      "id": "pack_menu",
      "target": "product.pack_keys",
      "sample": "weighted_subset",
      "weights": {
        "bag60g": 1,
        "bag180g": 1,
        "4x14g": 0,
        "12x14g": 0,
        "outer50g": 0,
        "outer170g": 0
      },
      "count_weights": {
        "1": 3,
        "2": 2
      },
      "cases": [
        {
          "when": "product.facts.format == 'puree'",
          "weights": {
            "bag60g": 0,
            "bag180g": 0,
            "4x14g": 1,
            "12x14g": 1,
            "outer50g": 0,
            "outer170g": 0
          }
        },
        {
          "when": "product.facts.format == 'freeze_dried'",
          "weights": {
            "bag60g": 0,
            "bag180g": 0,
            "4x14g": 0,
            "12x14g": 0,
            "outer50g": 1,
            "outer170g": 1
          }
        }
      ]
    },
    {
      "id": "pack_skus",
      "for_each": {
        "binding": "group.pack_key",
        "from": "product.pack_keys"
      },
      "steps": [
        {
          "id": "pack_bundle",
          "target": "group.pack",
          "sample": "weighted_choice",
          "weights": {
            "bag60g": 1,
            "bag180g": 0,
            "4x14g": 0,
            "12x14g": 0,
            "outer50g": 0,
            "outer170g": 0
          },
          "cases": [
            {
              "when": "group.pack_key == 'bag180g'",
              "weights": {
                "bag60g": 0,
                "bag180g": 1,
                "4x14g": 0,
                "12x14g": 0,
                "outer50g": 0,
                "outer170g": 0
              }
            },
            {
              "when": "group.pack_key == '4x14g'",
              "weights": {
                "bag60g": 0,
                "bag180g": 0,
                "4x14g": 1,
                "12x14g": 0,
                "outer50g": 0,
                "outer170g": 0
              }
            },
            {
              "when": "group.pack_key == '12x14g'",
              "weights": {
                "bag60g": 0,
                "bag180g": 0,
                "4x14g": 0,
                "12x14g": 1,
                "outer50g": 0,
                "outer170g": 0
              }
            },
            {
              "when": "group.pack_key == 'outer50g'",
              "weights": {
                "bag60g": 0,
                "bag180g": 0,
                "4x14g": 0,
                "12x14g": 0,
                "outer50g": 1,
                "outer170g": 0
              }
            },
            {
              "when": "group.pack_key == 'outer170g'",
              "weights": {
                "bag60g": 0,
                "bag180g": 0,
                "4x14g": 0,
                "12x14g": 0,
                "outer50g": 0,
                "outer170g": 1
              }
            }
          ],
          "values": {
            "bag60g": {
              "unit_mass": 60,
              "count": 1,
              "multiplier": 0.09
            },
            "bag180g": {
              "unit_mass": 180,
              "count": 1,
              "multiplier": 0.234
            },
            "4x14g": {
              "unit_mass": 14,
              "count": 4,
              "multiplier": 0.084
            },
            "12x14g": {
              "unit_mass": 14,
              "count": 12,
              "multiplier": 0.2184
            },
            "outer50g": {
              "unit_mass": 50,
              "count": 1,
              "multiplier": 0.065
            },
            "outer170g": {
              "unit_mass": 170,
              "count": 1,
              "multiplier": 0.187
            }
          }
        },
        {
          "id": "inner_mass",
          "target": "group.unit_net_mass_g",
          "derive": "group.pack.unit_mass"
        },
        {
          "id": "unit_count",
          "target": "group.unit_count",
          "derive": "group.pack.count"
        },
        {
          "id": "total_mass",
          "target": "group.total_net_mass_g",
          "derive": "group.unit_net_mass_g * group.unit_count"
        },
        {
          "id": "pack_multiplier",
          "target": "group.price_multiplier",
          "derive": "group.pack.multiplier"
        },
        {
          "id": "pack_price",
          "target": "group.reference_price_sek",
          "derive": "product.reference_price_sek * group.price_multiplier"
        },
        {
          "id": "skus",
          "target": "product.skus",
          "emit": {
            "sku_id": "product.product_id + '-' + group.pack_key",
            "product_id": "product.product_id",
            "unit_net_mass_g": "group.unit_net_mass_g",
            "unit_count": "group.unit_count",
            "total_net_mass_g": "group.total_net_mass_g",
            "price_multiplier": "group.price_multiplier",
            "reference_price_sek": "group.reference_price_sek"
          }
        }
      ]
    }
  ],
