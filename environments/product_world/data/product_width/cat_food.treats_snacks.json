        "puree": 2,
        "freeze_dried": 1
      }
    },
    {
      "id": "format_bundle",
      "target": "internal.format",
      "sample": "weighted_choice",
      "weights": {
        "crunchy": 1,
        "puree": 0,
        "freeze_dried": 0
      },
      "cases": [
        {
          "when": "product.facts.format == 'puree'",
          "weights": {
            "crunchy": 0,
            "puree": 1,
            "freeze_dried": 0
          }
        },
        {
          "when": "product.facts.format == 'freeze_dried'",
          "weights": {
            "crunchy": 0,
            "puree": 0,
            "freeze_dried": 1
          }
        }
      ],
      "values": {
        "crunchy": {
          "texture": "crunchy outside, soft filled centre",
          "container": "resealable bag",
          "opening": "bag zipper",
          "handling": "taking pieces from the bag",
          "ingredient_pct": 4,
          "ingredient_scope": "partial unordered whole-food composition",
          "other_ingredients": "cereals and other animal derivatives",
          "protein": 22,
          "fat": 20,
          "fibre": 2,
          "ash": 8,
          "moisture": -1,
          "kcal_per100g": 400,
          "price_factor": 1
        },
        "puree": {
          "texture": "smooth puree",
          "container": "carton of inner squeeze tubes",
          "opening": "inner tube tear-notch",
          "handling": "squeezing a small usual snack from the inner tube",
          "ingredient_pct": 30,
          "ingredient_scope": "partial unordered whole-food composition",
          "other_ingredients": "tapioca, scallop extract and collagen",
          "protein": 8.8,
          "fat": 0.5,
          "fibre": 0.1,
          "ash": 1.3,
          "moisture": 87,
          "kcal_per100g": 50,
          "price_factor": 1
        },
