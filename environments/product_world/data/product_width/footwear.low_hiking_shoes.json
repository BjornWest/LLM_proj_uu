{
  "schema_version": "product-package-v1",
  "concept_id": "footwear.low_hiking_shoes",
  "random_namespace": "product-width-footwear.low_hiking_shoes-v1",
  "extends": "_footwear_base.json",
  "status": "domain_accepted_not_production_integrated",
  "fields": {
    "brand.emphasis_weights": {
      "type": "object",
      "input": true
