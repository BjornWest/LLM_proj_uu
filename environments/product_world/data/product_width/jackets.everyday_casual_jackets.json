    },
    "request.max_mass_g": {
      "type": "number",
      "unit": "g",
      "optional": true
    }
  },
  "steps": [
    {
      "id": "body_bundle",
      "target": "internal.body",
      "sample": "weighted_choice",
      "weights": {
        "denim": 3,
        "harrington": 2,
        "chore": 3
      },
      "values": {
        "denim": {
          "construction": "denim trucker",
          "fabric": "denim",
          "cotton": 100,
          "polyester": 0,
          "lining": "none",
          "collar": "point collar",
          "entry": "buttons",
          "pocket_closure": "open",
          "mass_g": 750
        },
        "harrington": {
          "construction": "woven-blend Harrington",
          "fabric": "woven blend",
          "cotton": 42,
          "polyester": 58,
          "lining": "polyester",
          "collar": "dog-ear collar",
          "entry": "zip",
          "pocket_closure": "buttons",
          "mass_g": 500
        },
        "chore": {
          "construction": "canvas chore",
          "fabric": "canvas",
          "cotton": 100,
          "polyester": 0,
          "lining": "none",
          "collar": "corduroy point collar",
          "entry": "buttons",
          "pocket_closure": "open",
          "mass_g": 850
        }
      }
    },
    {
      "id": "construction",
      "target": "product.facts.construction",
      "derive": "internal.body.construction"
    },
    {
      "id": "fabric",
      "target": "product.facts.shell_fabric",
      "derive": "internal.body.fabric"
    },
    {
      "id": "cotton",
      "target": "product.facts.shell_cotton_percent",
      "derive": "internal.body.cotton"
    },
    {
      "id": "polyester",
      "target": "product.facts.shell_polyester_percent",
      "derive": "internal.body.polyester"
    },
    {
      "id": "lining",
      "target": "product.facts.body_lining",
      "derive": "internal.body.lining"
    },
    {
      "id": "collar",
      "target": "product.facts.collar_style",
      "derive": "internal.body.collar"
    },
    {
      "id": "entry",
      "target": "product.facts.entry_kind",
      "derive": "internal.body.entry"
    },
    {
      "id": "pocket_closure",
      "target": "product.facts.hand_pocket_closure",
      "derive": "internal.body.pocket_closure"
    },
    {
      "id": "lined",
      "target": "product.facts.lined",
      "derive": "product.facts.body_lining != 'none'"
    },
    {
      "id": "collar_material",
      "target": "product.facts.collar_material",
      "derive": "'corduroy' if product.facts.collar_style == 'corduroy point collar' else product.facts.shell_fabric"
    },
    {
      "id": "corduroy_fibre",
      "target": "product.facts.corduroy_collar_fibre",
      "derive": "'not specified'",
      "when": "product.facts.collar_style == 'corduroy point collar'"
    },
    {
      "id": "zip_function",
      "target": "product.facts.two_way_zip",
      "sample": "weighted_choice",
      "weights": {
        "yes": 0,
        "no": 1
      },
      "cases": [
        {
          "when": "product.facts.entry_kind == 'zip'",
          "weights": {
            "yes": 3,
            "no": 1
          }
        }
      ],
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "front_closure",
      "target": "product.facts.front_closure",
      "derive": "'front buttons' if product.facts.entry_kind == 'buttons' else ('two-way full front zip' if product.facts.two_way_zip else 'one-way full front zip')"
    },
    {
      "id": "cuff",
      "target": "product.facts.cuff_adjustable",
      "sample": "weighted_choice",
      "weights": {
        "yes": 1,
        "no": 1
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "collar_fastening",
      "target": "product.facts.collar_button_fastening",
      "sample": "weighted_choice",
      "weights": {
        "yes": 0,
        "no": 1
      },
      "cases": [
        {
          "when": "product.facts.collar_style == 'dog-ear collar'",
          "weights": {
            "yes": 3,
            "no": 1
          }
        }
      ],
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "collar_button_count",
      "target": "product.facts.collar_button_count",
      "derive": "2",
      "when": "product.facts.collar_button_fastening"
    },
    {
      "id": "cut",
      "target": "product.facts.cut",
      "sample": "weighted_choice",
      "weights": {
        "slim": 2,
        "regular": 4,
        "relaxed": 3
      }
    },
    {
      "id": "mass_noise",
      "target": "internal.mass_noise_g",
      "sample": "uniform_int",
      "min": -50,
      "max": 50
    },
    {
      "id": "mass",
      "target": "product.facts.reference_mass_g",
      "derive": "internal.body.mass_g + internal.mass_noise_g"
    }
  ],
  "language": [
    {
      "id": "description.body",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.construction",
          "product.facts.shell_fabric",
          "product.facts.shell_cotton_percent",
          "product.facts.shell_polyester_percent",
          "product.facts.body_lining",
          "product.facts.lined",
          "product.facts.collar_style",
          "product.facts.collar_material"
        ]
      },
      "slots": {
        "style": "product.facts.construction",
        "fabric": "product.facts.shell_fabric",
        "cotton": "product.facts.shell_cotton_percent",
        "polyester": "product.facts.shell_polyester_percent",
        "lining": "product.facts.body_lining",
        "collar": "product.facts.collar_style"
      },
      "formulations": [
        "{style}: {fabric} shell, {cotton}% cotton/{polyester}% polyester; body lining {lining}; {collar}.",
        "A {style} with {cotton}% cotton and {polyester}% polyester {fabric} shell; lining: {lining}; collar: {collar}."
      ]
    },
    {
      "id": "description.controls",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.front_closure",
          "product.facts.cut",
          "product.facts.hand_pocket_count",
          "product.facts.hand_pocket_closure",
          "product.facts.cuff_adjustable",
          "product.facts.collar_button_fastening"
        ]
      },
      "slots": {
        "front": "product.facts.front_closure",
        "cut": "product.facts.cut",
        "pocket": "product.facts.hand_pocket_closure",
        "cuff": "'present' if product.facts.cuff_adjustable else 'absent'",
        "collar": "'present' if product.facts.collar_button_fastening else 'absent'"
      },
      "formulations": [
        "{front}, {cut} cut; two hand pockets with {pocket} closure; cuff adjustment {cuff}; collar-button fastening {collar}.",
        "A {cut}-cut jacket with {front}; hand pockets: two, closure {pocket}; cuff adjustment {cuff}; collar-button fastening {collar}."
      ]
    },
    {
      "id": "description.collar_buttons",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.collar_button_count",
          "product.facts.collar_button_fastening"
        ]
      },
      "slots": {},
      "formulations": [
        "Two buttons fasten the collar, separate from front entry.",
        "Collar fastening uses two buttons; this is not the front-entry fastening."
      ],
      "when": "product.facts.collar_button_fastening"
    },
    {
      "id": "description.corduroy",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.collar_material",
          "product.facts.corduroy_collar_fibre"
        ]
      },
      "slots": {},
      "formulations": [
        "The local corduroy collar fibre composition is unspecified.",
        "No specified fibre composition for the corduroy collar component."
      ],
      "when": "product.facts.collar_style == 'corduroy point collar'"
    },
    {
      "id": "description.absence",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.dedicated_fill",
          "product.facts.membrane_present",
          "product.facts.hood_present"
        ]
      },
      "slots": {},
      "formulations": [
        "No dedicated fill, membrane or hood in this assembly.",
        "Dedicated insulating fill, membrane and hood are absent."
      ]
    },
    {
      "id": "description.unknowns",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.surface_finish",
          "product.facts.fabric_areal_mass",
          "product.facts.stretch_percentage",
          "product.facts.waterproof_rating",
          "product.facts.thermal_rating",
          "product.facts.abrasion_rating"
        ]
      },
      "slots": {},
      "formulations": [
        "Surface finish, fabric areal mass, stretch percentage and numeric waterproof/thermal/abrasion ratings unspecified.",
        "No specified surface finish, fabric g/m², stretch percentage or quantitative waterproof/thermal/abrasion result."
      ]
    },
    {
      "id": "description.mass",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.reference_mass_g",
          "product.facts.mass_basis"
        ]
      },
      "slots": {
        "mass": "product.facts.reference_mass_g"
      },
      "formulations": [
        "One nominal sizeM reference garment weighs {mass} g.",
        "Reference mass: {mass} g for one garment in nominal sizeM."
      ]
    }
  ],
  "rules": [
    {
      "id": "brand_scope",
      "require": "'jackets.everyday_casual_jackets' in brand.eligible_concepts"
    },
    {
      "id": "shell_total",
      "require": "product.facts.shell_cotton_percent + product.facts.shell_polyester_percent == 100"
    }
  ],
  "bindings": [
    {
      "id": "construction",
      "role": "filter",
      "predicate": "product.facts.construction == request.construction",
      "support": "proposal_not_registered"
    },
    {
      "id": "lining",
      "role": "filter",
      "predicate": "product.facts.lined == request.lined",
      "support": "proposal_not_registered"
    },
    {
      "id": "mass",
      "role": "filter",
      "predicate": "product.facts.reference_mass_g <= request.max_mass_g",
      "support": "proposal_not_registered"
    }
  ],
  "programs": {
    "review": {
      "fields": {
        "profile.positioning": {
          "type": "enum",
          "values": [
            "budget",
            "mainstream",
            "premium"
          ],
          "input": true
        },
        "profile.execution": {
          "type": "number",
          "input": true,
          "min": 0,
          "max": 1
        },
        "product.product_id": {
          "type": "string",
          "input": true
        },
        "product.skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "colour": {
                "type": "string"
              },
              "size_label": {
                "type": "string"
              }
            }
          },
          "input": true,
          "min_items": 1
        },
        "review.subject": {
          "type": "object",
          "properties": {
            "sku_id": {
              "type": "string"
            },
            "product_id": {
              "type": "string"
            },
            "colour": {
              "type": "string"
            },
            "size_label": {
              "type": "string"
            }
          }
        },
        "sku.sku_id": {
          "type": "string"
        },
        "sku.product_id": {
          "type": "string"
        },
        "review.rating": {
          "type": "integer",
          "min": 1,
          "max": 5
        },
        "review.eligible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review.topics": {
          "type": "set",
          "items": {
            "type": "enum",
            "values": [
              "value",
              "mild_walk_warmth",
              "arm_shoulder_movement",
              "front_fastening",
              "cuff_adjustment",
              "collar_button_operation",
              "lower_zip_operation"
            ]
          }
        },
        "product.reference_price_sek": {
          "type": "number",
          "unit": "SEK",
          "input": true,
          "min": 600,
          "max": 4800
        },
        "review.purchase_price_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.price_min_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 600
        },
        "review.price_max_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 4800
        },
        "review.value_price_position": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.value_favourability": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.positive_value": {
          "type": "boolean"
        },
        "review.positive_mild_walk_warmth": {
          "type": "boolean"
        },
        "review.positive_arm_shoulder_movement": {
          "type": "boolean"
        },
        "review.positive_front_fastening": {
          "type": "boolean"
        },
        "review.positive_cuff_adjustment": {
          "type": "boolean"
        },
        "review.positive_collar_button_operation": {
          "type": "boolean"
        },
        "review.positive_lower_zip_operation": {
          "type": "boolean"
        },
        "product.facts.cuff_adjustable": {
          "type": "boolean",
          "input": true
        },
        "product.facts.collar_button_fastening": {
          "type": "boolean",
          "input": true
        },
        "product.facts.two_way_zip": {
          "type": "boolean",
          "input": true
        },
        "product.facts.front_closure": {
          "type": "string",
          "input": true
        }
      },
      "steps": [
        {
          "id": "tested_sku",
          "target": "review.subject",
          "sample": "uniform_choice",
          "values_from": "product.skus"
        },
        {
          "id": "tested_id",
          "target": "sku.sku_id",
          "derive": "review.subject.sku_id"
        },
        {
          "id": "tested_product",
          "target": "sku.product_id",
          "derive": "review.subject.product_id"
        },
        {
          "id": "rating",
          "target": "review.rating",
          "sample": "rating",
          "execution": "profile.execution",
          "concentration": 1.5
        },
        {
          "id": "topic_applicability",
          "target": "review.eligible",
          "sample": "weighted_choice",
          "weights": {
            "000": 1,
            "001": 0,
            "010": 0,
            "011": 0,
            "100": 0,
            "101": 0,
            "110": 0,
            "111": 0
          },
          "cases": [
            {
              "when": "not product.facts.cuff_adjustable and not product.facts.collar_button_fastening and not product.facts.two_way_zip",
              "weights": {
                "000": 1,
                "001": 0,
                "010": 0,
                "011": 0,
                "100": 0,
                "101": 0,
                "110": 0,
                "111": 0
              }
            },
            {
              "when": "not product.facts.cuff_adjustable and not product.facts.collar_button_fastening and product.facts.two_way_zip",
              "weights": {
                "000": 0,
                "001": 1,
                "010": 0,
                "011": 0,
                "100": 0,
                "101": 0,
                "110": 0,
                "111": 0
              }
