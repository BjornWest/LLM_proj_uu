{
  "schema_version": "product-package-v1",
  "concept_id": "footwear.winter_boots",
  "random_namespace": "product-width-footwear.winter_boots-v1",
  "extends": "_footwear_base.json",
  "status": "domain_accepted_not_production_integrated",
  "fields": {
    "internal.winter_bundle": {
