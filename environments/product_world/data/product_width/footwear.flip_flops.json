      "cases": [
        {
          "when": "product.facts.component_materials.strap == 'EVA'",
          "weights": {
            "fixed thong": 3,
            "adjustable instep buckle": 2
          }
        }
      ]
    },
    {
      "id": "footbed_shape",
      "target": "product.facts.footbed_shape",
      "sample": "weighted_choice",
      "weights": {
        "flat textured": 4,
        "contoured": 1
      },
      "cases": [
        {
          "when": "product.facts.component_materials.footbed == 'EVA'",
          "weights": {
            "flat textured": 1,
            "contoured": 4
          }
        }
      ]
    },
    {
      "id": "mass_noise",
      "target": "internal.mass_noise_g",
      "sample": "uniform_int",
      "min": -10,
      "max": 10
    },
    {
      "id": "mass",
      "target": "product.facts.reference_mass_g",
      "derive": "internal.materials.mass_g + internal.mass_noise_g + (15 if product.facts.fastening == 'adjustable instep buckle' else 0)"
    }
  ],
