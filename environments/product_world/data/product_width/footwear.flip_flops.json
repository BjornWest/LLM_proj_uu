        },
        {
          "id": "rating",
          "target": "review.rating",
          "sample": "rating",
          "execution": "profile.execution",
          "concentration": 1.5
        },
        {
          "id": "topic_applicability",
          "target": "review.eligible",
          "sample": "weighted_choice",
          "weights": {
            "general": 1,
            "adjustable": 0
          },
          "cases": [
            {
              "when": "product.facts.fastening == 'adjustable instep buckle'",
              "weights": {
                "general": 0,
                "adjustable": 1
              }
            }
          ],
          "values": {
            "general": [
              "value",
              "short_casual_comfort",
              "toe_post_pressure",
              "instep_rubbing"
            ],
            "adjustable": [
              "value",
              "short_casual_comfort",
              "toe_post_pressure",
              "instep_rubbing",
              "buckle_adjustment"
            ]
          }
        },
        {
          "id": "topics",
          "target": "review.topics",
          "sample": "review_topics",
          "execution": "profile.execution",
          "positioning_from": "profile.positioning",
          "eligible_from": "review.eligible",
          "length_weights": {
            "0": 24,
            "1": 4,
            "2": 3,
            "3": 1
          }
        },
        {
          "id": "synthetic_purchase_price",
          "target": "review.purchase_price_sek",
