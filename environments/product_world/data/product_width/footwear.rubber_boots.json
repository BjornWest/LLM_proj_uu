        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.component_materials.lining": {
      "type": "string",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.insulation_kind": {
      "type": "string",
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.removable_inner_boot": {
      "type": "boolean",
      "constant": false,
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.footbed_material": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
          "description"
        ]
      }
    },
    "product.facts.removable_footbed": {
      "type": "string",
      "constant": "not specified",
      "unknown_values": [
        "not specified"
      ],
      "retail_presentation": {
        "allowed": [
