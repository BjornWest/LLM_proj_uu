    "request.heel_geometry": {
      "type": "string",
      "optional": true
    },
    "request.closed_toe": {
      "type": "boolean",
      "optional": true
    }
  },
  "steps": [
    {
      "id": "style_bundle",
      "target": "internal.style",
      "sample": "weighted_choice",
      "weights": {
        "court": 4,
        "slingback": 2,
        "sandal": 3
      },
      "values": {
        "court": {
          "style": "court shoe",
          "closed_toe": true,
          "closed_heel": true,
          "strap_position": "none",
          "closure": "slip-on",
          "toe_shape": "pointed",
          "mass_g": 270
        },
        "slingback": {
          "style": "slingback",
          "closed_toe": true,
          "closed_heel": false,
          "strap_position": "rear",
          "closure": "adjustable buckle",
          "toe_shape": "pointed",
          "mass_g": 250
        },
        "sandal": {
          "style": "dress sandal",
          "closed_toe": false,
          "closed_heel": false,
          "strap_position": "ankle",
          "closure": "adjustable buckle",
          "toe_shape": "almond",
          "mass_g": 290
        }
      }
    },
    {
      "id": "style",
      "target": "product.facts.style",
      "derive": "internal.style.style"
    },
    {
      "id": "closed_toe",
      "target": "product.facts.closed_toe",
      "derive": "internal.style.closed_toe"
    },
    {
      "id": "closed_heel",
      "target": "product.facts.closed_heel",
      "derive": "internal.style.closed_heel"
    },
    {
      "id": "strap_position",
      "target": "product.facts.strap_position",
      "derive": "internal.style.strap_position"
    },
    {
      "id": "closure",
      "target": "product.facts.fastening",
      "derive": "internal.style.closure"
    },
    {
      "id": "toe_shape",
      "target": "product.facts.toe_shape",
      "derive": "internal.style.toe_shape"
    },
    {
      "id": "heel_height",
      "target": "product.facts.heel_height_mm",
      "sample": "weighted_choice",
      "weights": {
        "40": 1,
        "50": 2,
        "63.5": 0,
        "70": 4,
        "90": 1
      },
      "cases": [
        {
          "when": "product.facts.style == 'slingback'",
          "weights": {
            "40": 0,
            "50": 2,
            "63.5": 0,
            "70": 4,
            "90": 1
          }
        },
        {
          "when": "product.facts.style == 'dress sandal'",
          "weights": {
            "40": 1,
            "50": 2,
            "63.5": 4,
            "70": 1,
            "90": 0
          }
        }
      ],
      "values": {
        "40": 40,
        "50": 50,
        "63.5": 63.5,
        "70": 70,
        "90": 90
      }
    },
    {
      "id": "heel_geometry",
      "target": "product.facts.heel_geometry",
      "sample": "weighted_choice",
      "weights": {
        "block": 1,
        "slim": 4
      },
      "cases": [
        {
          "when": "product.facts.style == 'dress sandal'",
          "weights": {
            "block": 4,
            "slim": 1
          }
        }
      ]
    },
    {
      "id": "upper",
      "target": "product.facts.component_materials.upper",
      "sample": "weighted_choice",
      "weights": {
        "smooth leather": 4,
        "suede leather": 2,
        "synthetic": 3
      }
    },
    {
      "id": "outsole",
      "target": "product.facts.component_materials.outsole",
      "sample": "weighted_choice",
      "weights": {
        "rubber": 3,
        "thermoplastic rubber": 2
      }
    },
    {
      "id": "cushion",
      "target": "product.facts.cushioning",
      "sample": "weighted_choice",
      "weights": {
        "minimal": 2,
        "modest": 3
      }
    },
    {
      "id": "mass_noise",
      "target": "internal.mass_noise_g",
      "sample": "uniform_int",
      "min": -20,
      "max": 20
    },
    {
      "id": "mass",
      "target": "product.facts.reference_mass_g",
      "derive": "internal.style.mass_g + internal.mass_noise_g + (10 if product.facts.heel_geometry == 'block' else 0)"
    }
  ],
  "language": [
    {
      "id": "description.style",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.style",
          "product.facts.closed_toe",
          "product.facts.closed_heel",
          "product.facts.strap_position",
          "product.facts.fastening",
          "product.facts.toe_shape"
        ]
      },
      "slots": {
        "style": "product.facts.style",
        "toe": "'enclosed' if product.facts.closed_toe else 'open'",
        "heel": "'enclosed' if product.facts.closed_heel else 'open'",
        "strap": "product.facts.strap_position",
        "closure": "product.facts.fastening",
        "shape": "product.facts.toe_shape"
      },
      "formulations": [
        "{style}: {shape} toe ({toe}), heel {heel}, strap position {strap}, fastening {closure}.",
        "A {style} with {shape} {toe} toe and {heel} heel; strap position: {strap}; closure: {closure}."
      ]
    },
    {
      "id": "description.materials",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.component_materials.upper",
          "product.facts.component_materials.outsole",
          "product.facts.cushioning",
          "product.facts.intended_use"
        ]
      },
      "slots": {
        "upper": "product.facts.component_materials.upper",
        "sole": "product.facts.component_materials.outsole",
        "cushion": "product.facts.cushioning"
      },
      "formulations": [
        "For occasion wear: {upper} upper, {sole} outsole and {cushion} cushioning.",
        "An occasion-wear design with {upper} above a {sole} outsole; cushioning is {cushion}."
      ]
    },
    {
      "id": "description.heel_mass",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.heel_height_mm",
          "product.facts.heel_geometry",
          "product.facts.reference_mass_g",
          "product.facts.mass_basis"
        ]
      },
      "slots": {
        "height": "product.facts.heel_height_mm",
        "geometry": "product.facts.heel_geometry",
        "mass": "product.facts.reference_mass_g"
      },
      "formulations": [
        "{geometry} heel, nominal height {height} mm; one EU40 reference shoe weighs {mass} g.",
        "Nominal heel height: {height} mm ({geometry}); reference mass: {mass} g per EU40 shoe."
      ]
    }
  ],
  "rules": [
    {
      "id": "brand_scope",
      "require": "'footwear.heeled_dress_shoes' in brand.eligible_concepts"
    }
  ],
  "bindings": [
    {
      "id": "heel_ceiling",
      "role": "task_requirement",
      "predicate": "product.facts.heel_height_mm <= request.maximum_heel_mm",
      "support": "proposal_not_registered"
    },
    {
      "id": "heel_geometry",
      "role": "filter",
      "predicate": "product.facts.heel_geometry == request.heel_geometry",
      "support": "proposal_not_registered"
    },
    {
      "id": "toe_exposure",
      "role": "filter",
      "predicate": "product.facts.closed_toe == request.closed_toe",
      "support": "proposal_not_registered"
    }
  ],
  "programs": {
    "review": {
      "fields": {
        "profile.positioning": {
          "type": "enum",
          "values": [
            "budget",
            "mainstream",
            "premium"
          ],
          "input": true
        },
        "profile.execution": {
          "type": "number",
          "input": true,
          "min": 0,
          "max": 1
        },
        "product.product_id": {
          "type": "string",
          "input": true
        },
        "product.skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "colour": {
                "type": "string"
              },
              "width": {
                "type": "string"
              },
              "size_eu": {
                "type": "integer"
              }
            }
          },
          "input": true,
          "min_items": 1
        },
        "review.subject": {
          "type": "object",
          "properties": {
            "sku_id": {
              "type": "string"
            },
            "product_id": {
              "type": "string"
            },
            "colour": {
              "type": "string"
            },
            "width": {
              "type": "string"
            },
            "size_eu": {
              "type": "integer"
            }
          }
        },
        "sku.sku_id": {
          "type": "string"
        },
        "sku.product_id": {
          "type": "string"
        },
        "review.rating": {
          "type": "integer",
          "min": 1,
          "max": 5
        },
        "review.eligible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review.topics": {
          "type": "set",
          "items": {
            "type": "enum",
            "values": [
              "value",
              "occasion_comfort",
              "forefoot_fit",
              "foot_retention",
              "ankle_pressure"
            ]
          }
        },
        "product.reference_price_sek": {
          "type": "number",
          "unit": "SEK",
          "input": true,
          "min": 400,
          "max": 3500
        },
        "review.purchase_price_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.price_min_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 400
        },
        "review.price_max_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 3500
        },
        "review.value_price_position": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.value_favourability": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.positive_value": {
          "type": "boolean"
        },
        "review.positive_occasion_comfort": {
          "type": "boolean"
        },
        "review.positive_forefoot_fit": {
          "type": "boolean"
        },
        "review.positive_foot_retention": {
          "type": "boolean"
        },
        "review.positive_ankle_pressure": {
          "type": "boolean"
        },
        "product.facts.strap_position": {
          "type": "enum",
          "values": [
            "none",
            "rear",
            "ankle"
          ],
          "input": true
        }
      },
      "steps": [
        {
          "id": "tested_sku",
          "target": "review.subject",
          "sample": "uniform_choice",
          "values_from": "product.skus"
        },
        {
          "id": "tested_id",
          "target": "sku.sku_id",
          "derive": "review.subject.sku_id"
        },
        {
          "id": "tested_product",
          "target": "sku.product_id",
          "derive": "review.subject.product_id"
        },
        {
          "id": "rating",
          "target": "review.rating",
          "sample": "rating",
          "execution": "profile.execution",
          "concentration": 1.5
        },
        {
          "id": "topic_applicability",
          "target": "review.eligible",
          "sample": "weighted_choice",
          "weights": {
            "general": 1,
            "ankle": 0
          },
          "cases": [
            {
              "when": "product.facts.strap_position == 'ankle'",
              "weights": {
                "general": 0,
                "ankle": 1
              }
            }
          ],
          "values": {
            "general": [
              "value",
              "occasion_comfort",
              "forefoot_fit",
              "foot_retention"
            ],
            "ankle": [
              "value",
              "occasion_comfort",
              "forefoot_fit",
              "foot_retention",
              "ankle_pressure"
            ]
          }
        },
        {
          "id": "topics",
          "target": "review.topics",
          "sample": "review_topics",
          "execution": "profile.execution",
          "positioning_from": "profile.positioning",
          "eligible_from": "review.eligible",
          "length_weights": {
            "0": 24,
            "1": 4,
            "2": 3,
            "3": 1
          }
        },
        {
          "id": "synthetic_purchase_price",
          "target": "review.purchase_price_sek",
          "derive": "product.reference_price_sek"
        },
        {
          "id": "relative_purchase_price",
          "target": "review.value_price_position",
          "derive": "(review.purchase_price_sek - review.price_min_sek) / (review.price_max_sek - review.price_min_sek)"
        },
        {
          "id": "value_favourability",
          "target": "review.value_favourability",
          "sample": "normal",
          "mean": "(review.rating - 1) / 4 - 0.2 * (review.value_price_position - 0.5)",
          "sd": 0.22,
          "min": 0,
          "max": 1,
          "bounds_mode": "clip",
          "round_to": 1e-06
        },
        {
          "id": "sentiment_value",
          "target": "review.positive_value",
          "derive": "review.value_favourability >= 0.5"
        },
        {
          "id": "sentiment_occasion_comfort",
          "target": "review.positive_occasion_comfort",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
            {
              "when": "review.rating >= 4",
              "weights": {
                "positive": 4,
                "negative": 1
              }
            },
            {
              "when": "review.rating <= 2",
              "weights": {
                "positive": 1,
                "negative": 4
              }
            }
          ],
          "values": {
            "positive": true,
            "negative": false
          }
        },
        {
          "id": "sentiment_forefoot_fit",
          "target": "review.positive_forefoot_fit",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
            {
              "when": "review.rating >= 4",
              "weights": {
                "positive": 4,
                "negative": 1
              }
            },
            {
              "when": "review.rating <= 2",
              "weights": {
                "positive": 1,
                "negative": 4
              }
            }
          ],
          "values": {
            "positive": true,
            "negative": false
          }
        },
        {
          "id": "sentiment_foot_retention",
          "target": "review.positive_foot_retention",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
            {
              "when": "review.rating >= 4",
              "weights": {
                "positive": 4,
                "negative": 1
              }
            },
            {
              "when": "review.rating <= 2",
              "weights": {
                "positive": 1,
                "negative": 4
              }
            }
          ],
          "values": {
            "positive": true,
            "negative": false
          }
        },
        {
          "id": "sentiment_ankle_pressure",
          "target": "review.positive_ankle_pressure",
          "sample": "weighted_choice",
          "weights": {
            "positive": 1,
            "negative": 1
          },
          "cases": [
            {
              "when": "review.rating >= 4",
              "weights": {
                "positive": 4,
                "negative": 1
              }
            },
            {
              "when": "review.rating <= 2",
              "weights": {
                "positive": 1,
                "negative": 4
              }
            }
          ],
          "values": {
            "positive": true,
            "negative": false
          }
        }
      ],
      "rules": [
        {
          "id": "tested_parent",
          "require": "sku.product_id == product.product_id"
        }
      ],
      "language": [
        {
          "id": "value.positive",
          "when": "'value' in review.topics and review.positive_value",
          "meaning": {
            "kind": "customer_experience",
            "aspect": "value",
            "polarity": "positive",
            "context": "purchase",
            "source": "first_hand"
          },
          "formulations": [
            "Good value for what I paid.",
            "It met my expectations at this price."
          ]
        },
        {
          "id": "value.negative",
          "when": "'value' in review.topics and not review.positive_value",
          "meaning": {
            "kind": "customer_experience",
            "aspect": "value",
            "polarity": "negative",
            "context": "purchase",
            "source": "first_hand"
          },
          "formulations": [
            "I expected more for the price.",
            "I would not pay this much again."
          ]
        },
        {
          "id": "occasion_comfort.positive",
          "when": "'occasion_comfort' in review.topics and review.positive_occasion_comfort",
          "meaning": {
            "kind": "customer_experience",
            "aspect": "occasion_comfort",
            "polarity": "positive",
            "context": "an evening occasion",
            "source": "first_hand"
          },
          "formulations": [
            "They felt comfortable throughout an evening occasion.",
            "Comfort was good throughout the evening occasion I wore them for."
          ]
        },
        {
          "id": "occasion_comfort.negative",
          "when": "'occasion_comfort' in review.topics and not review.positive_occasion_comfort",
          "meaning": {
            "kind": "customer_experience",
            "aspect": "occasion_comfort",
            "polarity": "negative",
            "context": "an evening occasion",
            "source": "first_hand"
          },
          "formulations": [
            "They felt uncomfortable throughout an evening occasion.",
            "Comfort was poor throughout the evening occasion I wore them for."
          ]
        },
        {
          "id": "forefoot_fit.positive",
          "when": "'forefoot_fit' in review.topics and review.positive_forefoot_fit",
          "meaning": {
            "kind": "customer_experience",
            "aspect": "forefoot_fit",
            "polarity": "positive",
            "context": "fit across forefoot",
            "source": "first_hand"
          },
          "formulations": [
            "My forefoot had enough room in the size I tried.",
            "The tested size did not squeeze my forefoot."
          ]
        },
        {
          "id": "forefoot_fit.negative",
          "when": "'forefoot_fit' in review.topics and not review.positive_forefoot_fit",
          "meaning": {
            "kind": "customer_experience",
            "aspect": "forefoot_fit",
            "polarity": "negative",
            "context": "fit across forefoot",
            "source": "first_hand"
          },
          "formulations": [
