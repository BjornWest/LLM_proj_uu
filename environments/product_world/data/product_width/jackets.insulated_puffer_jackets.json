  "steps": [
    {
      "id": "insulation_bundle",
      "target": "internal.insulation",
      "sample": "weighted_choice",
      "weights": {
        "down": 3,
        "synthetic": 3
      },
      "values": {
        "down": {
          "kind": "down",
          "material": "down",
          "distribution": "sewn baffles",
          "mass_g": 380
        },
        "synthetic": {
          "kind": "synthetic",
          "material": "polyester synthetic insulation",
          "distribution": "quilting",
          "mass_g": 320
        }
      }
    },
    {
      "id": "kind",
      "target": "product.facts.insulation_kind",
      "derive": "internal.insulation.kind"
    },
    {
      "id": "material",
      "target": "product.facts.insulation_material",
      "derive": "internal.insulation.material"
    },
    {
      "id": "distribution",
      "target": "product.facts.insulation_distribution",
      "derive": "internal.insulation.distribution"
    },
    {
      "id": "shell",
      "target": "product.facts.shell_fibre",
      "sample": "weighted_choice",
      "weights": {
        "nylon": 2,
        "polyester": 1
      }
    },
    {
      "id": "fill_power",
      "target": "product.facts.declared_down_fill_power",
      "sample": "weighted_choice",
      "weights": {
        "700": 1,
        "800": 1
      },
      "when": "product.facts.insulation_kind == 'down'",
      "values": {
        "700": 700,
        "800": 800
      }
    },
    {
      "id": "fill_mass",
      "target": "product.facts.declared_down_fill_mass_g",
      "sample": "weighted_choice",
      "weights": {
        "100": 1,
        "150": 1,
        "200": 1
      },
      "when": "product.facts.insulation_kind == 'down'",
      "values": {
        "100": 100,
        "150": 150,
        "200": 200
      }
    },
    {
      "id": "down_treatment",
      "target": "product.facts.hydrophobic_down_treatment",
      "sample": "weighted_choice",
      "weights": {
        "yes": 3,
        "no": 2
      },
      "when": "product.facts.insulation_kind == 'down'",
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "synthetic_areal_mass",
      "target": "product.facts.declared_synthetic_insulation_g_m2",
      "sample": "weighted_choice",
      "weights": {
        "60": 1,
        "100": 1
      },
      "when": "product.facts.insulation_kind == 'synthetic'",
      "values": {
        "60": 60,
        "100": 100
      }
    },
    {
      "id": "hood",
      "target": "product.facts.hood_style",
      "sample": "weighted_choice",
      "weights": {
        "absent": 1,
        "fixed": 2,
        "adjustable": 3
      }
    },
    {
      "id": "hood_present",
      "target": "product.facts.hood_present",
      "derive": "product.facts.hood_style != 'absent'"
    },
    {
      "id": "hood_adjustable",
      "target": "product.facts.hood_adjustable",
      "derive": "product.facts.hood_style == 'adjustable'"
    },
    {
      "id": "storage",
      "target": "product.facts.internal_pocket_storage",
      "sample": "weighted_choice",
      "weights": {
        "yes": 2,
        "no": 1
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "dwr",
      "target": "product.facts.shell_dwr",
      "sample": "weighted_choice",
      "weights": {
        "yes": 3,
        "no": 1
      },
      "values": {
        "yes": true,
        "no": false
      }
    },
    {
      "id": "cut",
      "target": "product.facts.cut",
      "sample": "weighted_choice",
      "weights": {
        "slim": 1,
        "regular": 5,
        "relaxed": 2
      }
    },
    {
      "id": "mass_noise",
      "target": "internal.mass_noise_g",
      "sample": "uniform_int",
      "min": -25,
      "max": 25
    },
    {
      "id": "mass",
      "target": "product.facts.reference_mass_g",
      "derive": "internal.insulation.mass_g + internal.mass_noise_g + (30 if product.facts.hood_present else 0) + (10 if product.facts.internal_pocket_storage else 0)"
    },
    {
      "id": "synthetic_total_fill_mass_status",
      "target": "product.facts.synthetic_total_fill_mass",
      "derive": "'not specified'",
      "when": "product.facts.insulation_kind == 'synthetic'"
    },
    {
      "id": "fill_power_test_method_status",
      "target": "product.facts.fill_power_test_method",
      "derive": "'not specified'",
      "when": "product.facts.insulation_kind == 'down'"
    },
    {
      "id": "fill_power_conditioning_status",
      "target": "product.facts.fill_power_conditioning",
      "derive": "'not specified'",
      "when": "product.facts.insulation_kind == 'down'"
    },
    {
      "id": "down_species_and_blend_status",
      "target": "product.facts.down_species_and_blend",
      "derive": "'not specified'",
      "when": "product.facts.insulation_kind == 'down'"
    }
  ],
  "language": [
    {
      "id": "description.body",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.shell_fibre",
          "product.facts.lining_fibre",
          "product.facts.insulation_material",
          "product.facts.insulation_distribution",
          "product.facts.dedicated_fill",
          "product.facts.membrane_present"
        ]
      },
      "slots": {
        "shell": "product.facts.shell_fibre",
        "fill": "product.facts.insulation_material",
        "distribution": "product.facts.insulation_distribution"
      },
      "formulations": [
        "{shell} shell and polyester lining, dedicated {fill} retained by {distribution}; no membrane in this assembly.",
        "Dedicated {fill} with {distribution}, a {shell} shell and polyester lining; membrane absent."
      ]
    },
    {
      "id": "description.down",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.declared_down_fill_power",
          "product.facts.declared_down_fill_mass_g",
          "product.facts.hydrophobic_down_treatment",
          "product.facts.fill_reference_basis",
          "product.facts.fill_power_test_method",
          "product.facts.fill_power_conditioning"
        ]
      },
      "slots": {
        "power": "product.facts.declared_down_fill_power",
        "fill": "product.facts.declared_down_fill_mass_g",
        "treated": "'present' if product.facts.hydrophobic_down_treatment else 'absent'"
      },
      "formulations": [
        "Declared down fill power {power} cuin/oz, method/conditioning unspecified; total down fill {fill} g for one nominal sizeM reference garment. Hydrophobic-down treatment {treated}.",
        "One nominal sizeM reference jacket: {fill} g total down fill; declared fill power {power} cuin/oz without specified protocol/conditioning; hydrophobic-down treatment {treated}."
      ],
      "when": "product.facts.insulation_kind == 'down'"
    },
    {
      "id": "description.synthetic",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.declared_synthetic_insulation_g_m2",
          "product.facts.synthetic_total_fill_mass"
        ]
      },
      "slots": {
        "areal": "product.facts.declared_synthetic_insulation_g_m2"
      },
      "formulations": [
        "Declared synthetic insulation areal mass {areal} g/m²; total synthetic fill grams unspecified.",
        "Synthetic insulation: {areal} g/m², not a total fill mass; no specified total fill grams."
      ],
      "when": "product.facts.insulation_kind == 'synthetic'"
    },
    {
      "id": "description.controls",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.front_closure",
          "product.facts.hood_style",
          "product.facts.hood_adjustable",
          "product.facts.internal_pocket_storage",
          "product.facts.hand_pocket_count",
          "product.facts.hand_pocket_closure",
          "product.facts.shell_dwr",
          "product.facts.cut"
        ]
      },
      "slots": {
        "hood": "product.facts.hood_style",
        "storage": "'present' if product.facts.internal_pocket_storage else 'absent'",
        "dwr": "'present' if product.facts.shell_dwr else 'absent'",
        "cut": "product.facts.cut"
      },
      "formulations": [
        "Full front zip, {cut} cut, hood {hood}, two zipped hand pockets; internal storage pocket {storage}; shell DWR {dwr}.",
        "A {cut}-cut jacket with full front zip and two zip hand pockets; hood: {hood}; internal pocket storage {storage}; shell DWR {dwr}."
      ]
    },
    {
      "id": "description.unknowns",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.down_species_and_blend",
          "product.facts.seam_treatment",
          "product.facts.waterproof_rating",
          "product.facts.thermal_rating",
          "product.facts.pack_volume"
        ]
      },
      "slots": {},
      "formulations": [
        "Down species/blend where applicable, seam treatment, quantitative waterproof/thermal ratings and numerical packed volume unspecified.",
        "No specified down species/blend where applicable, seam treatment, numeric waterproof/thermal results or packed volume."
      ]
    },
    {
      "id": "description.mass",
      "meaning": {
        "kind": "catalog_fact",
        "fact_paths": [
          "product.facts.reference_mass_g",
          "product.facts.mass_basis"
        ]
      },
      "slots": {
        "mass": "product.facts.reference_mass_g"
      },
      "formulations": [
        "One nominal sizeM reference garment weighs {mass} g.",
        "Reference mass: {mass} g for one garment in nominal sizeM."
      ]
    }
  ],
  "rules": [
    {
      "id": "brand_scope",
      "require": "'jackets.insulated_puffer_jackets' in brand.eligible_concepts"
    }
  ],
  "bindings": [
    {
      "id": "insulation",
      "role": "filter",
      "predicate": "product.facts.insulation_kind == request.insulation_kind",
      "support": "proposal_not_registered"
    },
    {
      "id": "down_power",
      "role": "filter",
      "predicate": "applicable(product.facts.declared_down_fill_power) and product.facts.insulation_kind == 'down' and product.facts.declared_down_fill_power >= request.minimum_down_fill_power",
      "support": "proposal_not_registered"
    },
    {
      "id": "mass",
      "role": "filter",
      "predicate": "product.facts.reference_mass_g <= request.max_mass_g",
      "support": "proposal_not_registered"
    }
  ],
  "programs": {
    "review": {
      "fields": {
        "profile.positioning": {
          "type": "enum",
          "values": [
            "budget",
            "mainstream",
            "premium"
          ],
          "input": true
        },
        "profile.execution": {
          "type": "number",
          "input": true,
          "min": 0,
          "max": 1
        },
        "product.product_id": {
          "type": "string",
          "input": true
        },
        "product.skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "colour": {
                "type": "string"
              },
              "size_label": {
                "type": "string"
              }
            }
          },
          "input": true,
          "min_items": 1
        },
        "review.subject": {
          "type": "object",
          "properties": {
            "sku_id": {
              "type": "string"
            },
            "product_id": {
              "type": "string"
            },
            "colour": {
              "type": "string"
            },
            "size_label": {
              "type": "string"
            }
          }
        },
        "sku.sku_id": {
          "type": "string"
        },
        "sku.product_id": {
          "type": "string"
        },
        "review.rating": {
          "type": "integer",
          "min": 1,
          "max": 5
        },
        "review.eligible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review.topics": {
          "type": "set",
          "items": {
            "type": "enum",
            "values": [
              "value",
              "cold_walk_warmth",
              "arm_movement",
              "front_zip_operation",
              "hood_adjustment",
              "pocket_packing"
            ]
          }
        },
        "product.reference_price_sek": {
          "type": "number",
          "unit": "SEK",
          "input": true,
          "min": 700,
          "max": 5000
        },
        "review.purchase_price_sek": {
          "type": "number",
          "unit": "SEK"
        },
        "review.price_min_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 700
        },
        "review.price_max_sek": {
          "type": "number",
          "unit": "SEK",
          "constant": 5000
        },
        "review.value_price_position": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.value_favourability": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "review.positive_value": {
          "type": "boolean"
        },
        "review.positive_cold_walk_warmth": {
          "type": "boolean"
        },
        "review.positive_arm_movement": {
          "type": "boolean"
        },
        "review.positive_front_zip_operation": {
          "type": "boolean"
        },
        "review.positive_hood_adjustment": {
          "type": "boolean"
        },
        "review.positive_pocket_packing": {
          "type": "boolean"
        },
        "product.facts.hood_adjustable": {
          "type": "boolean",
          "input": true
        },
        "product.facts.internal_pocket_storage": {
          "type": "boolean",
          "input": true
        }
      },
      "steps": [
        {
          "id": "tested_sku",
          "target": "review.subject",
          "sample": "uniform_choice",
          "values_from": "product.skus"
        },
        {
          "id": "tested_id",
          "target": "sku.sku_id",
          "derive": "review.subject.sku_id"
        },
        {
          "id": "tested_product",
          "target": "sku.product_id",
          "derive": "review.subject.product_id"
        },
        {
          "id": "rating",
          "target": "review.rating",
          "sample": "rating",
          "execution": "profile.execution",
          "concentration": 1.5
        },
        {
          "id": "topic_applicability",
          "target": "review.eligible",
          "sample": "weighted_choice",
          "weights": {
            "plain": 1,
            "hood": 0,
            "storage": 0,
            "both": 0
          },
          "cases": [
            {
              "when": "product.facts.hood_adjustable and product.facts.internal_pocket_storage",
              "weights": {
                "plain": 0,
                "hood": 0,
                "storage": 0,
                "both": 1
              }
            },
            {
              "when": "product.facts.hood_adjustable and not product.facts.internal_pocket_storage",
              "weights": {
                "plain": 0,
                "hood": 1,
                "storage": 0,
                "both": 0
              }
            },
