# Copy to .env and use --env-file .env, or export these in your shell.
# .env is ignored by Git. Never paste real keys into chats or tracked files.
PARALLEL_API_KEY=replace-with-your-key

# Optional: model inference (not needed for standalone search/development mode).
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen3.8-27b
OPENROUTER_PROVIDERS=chutes,dekallm,phala,parasail,akashml,ionstream,cloudflare
# OPENROUTER_PRESET is optional legacy routing; leave unset for session routing.
OPENROUTER_API_KEY=replace-with-your-key
# Run with --api-key-env OPENROUTER_API_KEY.

# Optional dedicated key for the private Vercel demo; separate from calibration.
# In Vercel this value is configured as OPENROUTER_API_KEY. See deploy/VERCEL_SETUP.md.
DAYLIGHT_OPENROUTER_API_KEY=replace-with-a-separately-budgeted-demo-key
