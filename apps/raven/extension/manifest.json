{
  "manifest_version": 3,
  "name": "Korp",
  "version": "0.1.0",
  "description": "Korp in your shared demo browser window",
  "permissions": [
    "sidePanel",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Korp",
    "default_icon": {
      "16": "icons/korp-16.png",
      "32": "icons/korp-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:*"
  },
  "icons": {
    "16": "icons/korp-16.png",
    "32": "icons/korp-32.png",
    "48": "icons/korp-48.png",
    "128": "icons/korp-128.png"
  }
}